+def _dilate_spatial(x, dim, s):
+    """Insert (s-1) zeros between elements along `dim` (L -> (L-1)*s+1) via a constant
+    dilation matrix: x[...,L] @ M[L, (L-1)*s+1] where M[i, i*s]=1. RANK-PRESERVING
+    (CoreML caps rank at 5, so stack/reshape tricks that add a dim fail on the rank-5
+    cost volume); matmul keeps rank. M is a trace-time constant. ConvTranspose3d helper."""
+    if s == 1:
+        return x
+    nd = x.dim()
+    perm = [i for i in range(nd) if i != dim] + [dim]   # bring `dim` to last (static list)
+    inv = [0] * nd
+    for i, p in enumerate(perm):
+        inv[p] = i
+    x = x.permute(*perm)
+    L = int(x.shape[-1]); Ls = (L - 1) * s + 1
+    # selector M[i,j]=1 iff j==i*s, built by broadcast-eq (a pure constant; NO index_put
+    # scatter -- the scatter folded in isolation but coremltools left it dynamic and
+    # mis-converted it inside the full cascade).
+    rows = torch.arange(L, device=x.device).unsqueeze(1)
+    cols = torch.arange(Ls, device=x.device).unsqueeze(0)
+    M = (cols == rows * s).to(x.dtype)                   # [L, Ls] constant
+    x = torch.matmul(x, M)                               # [..., L] -> [..., Ls], rank kept
+    return x.permute(*inv)
+
+
+def _convT3d_export(x, weight, bias, stride, padding, output_padding):
+    """Float-exact ConvTranspose3d WITHOUT the output_padding op (coremltools 9 only
+    supports output_padding for 1D/2D). Textbook identity: zero-dilate the input by
+    stride, apply asymmetric zero-pad (leading k-1-p, trailing k-1-p+output_padding),
+    then a stride-1 conv3d with the in/out-swapped, spatially-flipped weight. Matches
+    nn.ConvTranspose3d to ~1e-6. `weight` is [Cin, Cout, kD, kH, kW]."""
+    s = stride if isinstance(stride, tuple) else (stride,) * 3
+    p = padding if isinstance(padding, tuple) else (padding,) * 3
+    op = output_padding if isinstance(output_padding, tuple) else (output_padding,) * 3
+    k = weight.shape[2:]
+    for i, dim in enumerate((2, 3, 4)):
+        x = _dilate_spatial(x, dim, s[i])
+    pad = (k[2] - 1 - p[2], k[2] - 1 - p[2] + op[2],
+           k[1] - 1 - p[1], k[1] - 1 - p[1] + op[1],
+           k[0] - 1 - p[0], k[0] - 1 - p[0] + op[0])
+    x = F.pad(x, pad)
+    wc = weight.permute(1, 0, 2, 3, 4).flip(2, 3, 4)
+    return F.conv3d(x, wc, bias, stride=1, padding=0)
+
 
