+def _inv3x3(M):
+    """Analytic 3x3 inverse (cofactor/adjugate). CoreML-convertible — avoids
+    aten::inverse, which coremltools has no conversion for."""
+    a, b, c = M[:, 0, 0], M[:, 0, 1], M[:, 0, 2]
+    d, e, f = M[:, 1, 0], M[:, 1, 1], M[:, 1, 2]
+    g, h, i = M[:, 2, 0], M[:, 2, 1], M[:, 2, 2]
+    A = e * i - f * h; Bb = -(d * i - f * g); Cc = d * h - e * g
+    D = -(b * i - c * h); E = a * i - c * g; Ff = -(a * h - b * g)
+    G = b * f - c * e; H = -(a * f - c * d); I = a * e - b * d
+    det = a * A + b * Bb + c * Cc
+    inv_det = (1.0 / det).view(-1, 1, 1)
+    row0 = torch.stack([A, D, G], dim=-1)
+    row1 = torch.stack([Bb, E, H], dim=-1)
+    row2 = torch.stack([Cc, Ff, I], dim=-1)
+    return torch.stack([row0, row1, row2], dim=1) * inv_det
+
+
+def _invert_affine4x4(P):
+    """Inverse of a [B,4,4] whose bottom row is [0,0,0,1] (true for the K@[R|t]
+    projection matrices here). = [[M^-1, -M^-1 p],[0,0,0,1]]."""
+    M = P[:, :3, :3]; p = P[:, :3, 3:4]
+    Minv = _inv3x3(M)
+    pinv = -torch.matmul(Minv, p)
+    top = torch.cat([Minv, pinv], dim=2)                       # [B,3,4]
+    bottom = torch.zeros(P.shape[0], 1, 4, dtype=P.dtype, device=P.device)
+    bottom[:, 0, 3] = 1.0
+    return torch.cat([top, bottom], dim=1)
+
