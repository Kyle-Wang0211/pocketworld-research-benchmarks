+    }
+    guard descriptor >= 0 else {
+      let capturedErrno = errno
+      throw NSError(
+        domain: NSPOSIXErrorDomain,
+        code: Int(capturedErrno),
+        userInfo: [NSLocalizedDescriptionKey: "open for sync failed: \(url.path)"]
