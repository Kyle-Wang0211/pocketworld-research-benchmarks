+  private static func percentile(_ values: [Double], _ fraction: Double) -> Double {
+    guard !values.isEmpty else { return 0 }
+    let sorted = values.sorted()
+    let index = Int(
+      (Double(sorted.count - 1) * min(max(fraction, 0), 1)).rounded()
     )
+    return sorted[index]
   }
 
