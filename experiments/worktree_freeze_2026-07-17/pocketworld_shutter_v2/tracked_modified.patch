+    persistedManualEvidence = await loadPersistedManualCaptureEvidence(
+      captureDir,
+    );
+  } catch (error) {
+    return SfmRecoveryInputInspection(
+      hasDurableState: true,
+      canExplicitlyResume: false,
+      reason: 'manual_capture_evidence_failed:$error',
+    );
+  }
