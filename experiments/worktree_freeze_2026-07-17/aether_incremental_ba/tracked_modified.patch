+bool AetherExactSiteTrackAvailable(
+    const colmap::Reconstruction& reconstruction,
+    const colmap::Track& track,
+    const Eigen::Vector3d& candidate_xyz) {
+  for (const colmap::TrackElement& element : track.Elements()) {
+    if (!AetherExactSiteObservationAvailable(
+            reconstruction,
+            element.image_id,
+            element.point2D_idx,
+            candidate_xyz)) {
+      return false;
+    }
+  }
+  return true;
+}
