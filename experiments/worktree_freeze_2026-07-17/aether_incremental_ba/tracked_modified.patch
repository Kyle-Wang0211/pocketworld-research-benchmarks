+// [AETHER SURFACE-OWNERSHIP 2026-07-15] A compact deterministic 3D k-d tree.
+// Keeping this private to bundle adjustment avoids a new dependency in the
+// cross-platform COLMAP core. It is built once from the variable points in a
+// global BA problem and queried only while constructing frozen local planes.
+class AetherPointKdTree {
+ public:
+  explicit AetherPointKdTree(const std::vector<Eigen::Vector3d>& points)
+      : points_(points), order_(points.size()) {
+    std::iota(order_.begin(), order_.end(), 0);
+    nodes_.reserve(points.size());
+    root_ = Build(0, order_.size());
+  }
+
+  std::vector<std::pair<double, size_t>> Query(
+      const Eigen::Vector3d& query,
+      const size_t excluded_index,
+      const size_t num_neighbors) const {
+    using Candidate = std::pair<double, size_t>;  // squared distance, index
+    std::priority_queue<Candidate> heap;
+    QueryNode(root_, query, excluded_index, num_neighbors, &heap);
+    std::vector<Candidate> result;
+    result.reserve(heap.size());
+    while (!heap.empty()) {
+      result.push_back(heap.top());
+      heap.pop();
+    }
+    std::sort(result.begin(), result.end());
+    return result;
+  }
+
+ private:
+  struct Node {
+    size_t point_index = 0;
+    int axis = 0;
+    int left = -1;
+    int right = -1;
+  };
+
+  int Build(const size_t begin, const size_t end) {
+    if (begin >= end) {
+      return -1;
+    }
+    Eigen::Vector3d lower = points_[order_[begin]];
+    Eigen::Vector3d upper = lower;
+    for (size_t i = begin + 1; i < end; ++i) {
+      lower = lower.cwiseMin(points_[order_[i]]);
+      upper = upper.cwiseMax(points_[order_[i]]);
+    }
+    Eigen::Index axis = 0;
+    (upper - lower).maxCoeff(&axis);
+    const size_t middle = begin + (end - begin) / 2;
+    std::nth_element(
+        order_.begin() + begin,
+        order_.begin() + middle,
+        order_.begin() + end,
+        [this, axis](const size_t lhs, const size_t rhs) {
+          const double lhs_value = points_[lhs](axis);
+          const double rhs_value = points_[rhs](axis);
+          return lhs_value < rhs_value ||
+                 (lhs_value == rhs_value && lhs < rhs);
+        });
+    const int node_index = static_cast<int>(nodes_.size());
+    nodes_.push_back(Node{order_[middle], static_cast<int>(axis), -1, -1});
+    nodes_[node_index].left = Build(begin, middle);
+    nodes_[node_index].right = Build(middle + 1, end);
+    return node_index;
+  }
+
+  void QueryNode(
+      const int node_index,
+      const Eigen::Vector3d& query,
+      const size_t excluded_index,
+      const size_t num_neighbors,
+      std::priority_queue<std::pair<double, size_t>>* heap) const {
+    if (node_index < 0) {
+      return;
+    }
+    const Node& node = nodes_[node_index];
+    const Eigen::Vector3d& point = points_[node.point_index];
+    const double delta_axis = query(node.axis) - point(node.axis);
+    const int near_node = delta_axis <= 0.0 ? node.left : node.right;
+    const int far_node = delta_axis <= 0.0 ? node.right : node.left;
+    QueryNode(near_node, query, excluded_index, num_neighbors, heap);
+
+    if (node.point_index != excluded_index) {
+      const std::pair<double, size_t> candidate{
+          (query - point).squaredNorm(), node.point_index};
