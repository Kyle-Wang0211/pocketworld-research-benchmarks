+double SiteDescriptorCosine(const FrameRecord& frame, const uint32_t a,
+                            const uint32_t b) {
+  if (a >= static_cast<uint32_t>(frame.n_keypoints) ||
+      b >= static_cast<uint32_t>(frame.n_keypoints) ||
+      frame.descriptors.size() <
+          static_cast<size_t>(frame.n_keypoints) * 128) {
+    return -1.0;
+  }
+  const uint8_t* da = frame.descriptors.data() + static_cast<size_t>(a) * 128;
+  const uint8_t* db = frame.descriptors.data() + static_cast<size_t>(b) * 128;
+  double dot = 0.0;
+  double na = 0.0;
+  double nb = 0.0;
+  for (int k = 0; k < 128; ++k) {
+    const double va = da[k];
+    const double vb = db[k];
+    dot += va * vb;
+    na += va * va;
+    nb += vb * vb;
+  }
+  if (na <= 0.0 || nb <= 0.0) return -1.0;
+  return dot / std::sqrt(na * nb);
+}
+
+double CrossFrameDescriptorCosine(const FrameRecord& frame1,
+                                  const uint32_t idx1,
+                                  const FrameRecord& frame2,
+                                  const uint32_t idx2) {
+  if (idx1 >= static_cast<uint32_t>(frame1.n_keypoints) ||
+      idx2 >= static_cast<uint32_t>(frame2.n_keypoints) ||
+      frame1.descriptors.size() <
+          static_cast<size_t>(frame1.n_keypoints) * 128 ||
+      frame2.descriptors.size() <
+          static_cast<size_t>(frame2.n_keypoints) * 128) {
+    return -1.0;
+  }
+  const uint8_t* d1 =
+      frame1.descriptors.data() + static_cast<size_t>(idx1) * 128;
+  const uint8_t* d2 =
+      frame2.descriptors.data() + static_cast<size_t>(idx2) * 128;
+  double dot = 0.0;
+  double n1 = 0.0;
+  double n2 = 0.0;
+  for (int k = 0; k < 128; ++k) {
+    const double a = d1[k];
+    const double b = d2[k];
+    dot += a * b;
+    n1 += a * a;
+    n2 += b * b;
+  }
+  if (n1 <= 0.0 || n2 <= 0.0) return -1.0;
+  return dot / std::sqrt(n1 * n2);
+}
+
+uint32_t CanonicalPhysicalSite(const FrameRecord& frame,
+                               const uint32_t feature_idx) {
+  if (feature_idx >= frame.points.size() || frame.exact_site_grid.empty()) {
+    return feature_idx;
+  }
+  const auto site =
+      frame.exact_site_grid.find(ExactSiteKey(frame.points[feature_idx]));
+  if (site == frame.exact_site_grid.end() || site->second.empty()) {
+    return feature_idx;
+  }
+  // PrepareSiteOwnershipFrame inserts features in ascending descriptor order.
+  return site->second.front();
+}
+
+int64_t CrossFrameDescriptorDot(const FrameRecord& frame1,
+                                const uint32_t idx1,
+                                const FrameRecord& frame2,
+                                const uint32_t idx2) {
+  if (idx1 >= static_cast<uint32_t>(frame1.n_keypoints) ||
+      idx2 >= static_cast<uint32_t>(frame2.n_keypoints) ||
+      frame1.descriptors.size() <
+          static_cast<size_t>(frame1.n_keypoints) * 128 ||
+      frame2.descriptors.size() <
+          static_cast<size_t>(frame2.n_keypoints) * 128) {
+    return 0;
+  }
+  const uint8_t* d1 =
+      frame1.descriptors.data() + static_cast<size_t>(idx1) * 128;
+  const uint8_t* d2 =
+      frame2.descriptors.data() + static_cast<size_t>(idx2) * 128;
+  int64_t dot = 0;
+  for (int k = 0; k < 128; ++k) {
+    dot += static_cast<int64_t>(d1[k]) * static_cast<int64_t>(d2[k]);
+  }
+  return dot;
+}
