+bool IsExactSiteConflict(const FrameRecord& frame, const uint32_t feature_idx) {
+  if (!ConflictMultiViewBirthEnabled() ||
+      feature_idx >= frame.points.size() || frame.exact_site_grid.empty()) {
+    return false;
+  }
+  const auto bucket =
+      frame.exact_site_grid.find(ExactSiteKey(frame.points[feature_idx]));
+  return bucket != frame.exact_site_grid.end() && bucket->second.size() > 1;
+}
+
+uint32_t ResolveSiteAlias(const FrameRecord& frame, uint32_t idx) {
+  if (idx >= frame.site_alias.size()) return idx;
+  // Aliases always point to an already-owned observation, so chains should be
+  // one hop. The bound makes corrupt/cyclic experimental state fail closed.
+  for (int hop = 0; hop < 16; ++hop) {
+    const uint32_t next = frame.site_alias[idx];
+    if (next == idx || next >= frame.site_alias.size()) return idx;
+    idx = next;
+  }
+  return idx;
+}
