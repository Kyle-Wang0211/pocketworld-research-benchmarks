+  int64_t verified_sites = 0;
+  int64_t competing_sites = 0;
+  int64_t competing_aliases = 0;
+  int64_t weighted_sites = 0;
+  int64_t weighted_support = 0;
+  int64_t geometric_components = 0;
+  int64_t geometric_conflicts = 0;
+  int64_t geometric_decisions = 0;
