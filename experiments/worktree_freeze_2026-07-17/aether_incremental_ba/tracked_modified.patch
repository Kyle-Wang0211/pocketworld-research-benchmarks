+int64_t SiteGridKey(const int x, const int y) {
+  return static_cast<int64_t>((static_cast<uint64_t>(static_cast<uint32_t>(x))
+                               << 32) |
+                              static_cast<uint32_t>(y));
+}
+
+uint64_t ExactSiteKey(const Eigen::Vector2d& xy) {
+  const float x = static_cast<float>(xy.x());
+  const float y = static_cast<float>(xy.y());
+  uint32_t xb = 0;
+  uint32_t yb = 0;
+  std::memcpy(&xb, &x, sizeof(xb));
+  std::memcpy(&yb, &y, sizeof(yb));
+  return (static_cast<uint64_t>(xb) << 32) | yb;
+}
+
+void PrepareSiteOwnershipFrame(FrameRecord* frame) {
+  if (!frame ||
+      (!SiteBirthOwnerEnabled() && !ExactSiteIdentityEnabled() &&
+       !ExactSiteBirthOwnerEnabled() &&
+       !ExactSiteOwnerV2Enabled() &&
+       !ConflictMultiViewBirthEnabled() &&
+       !PostGeometrySiteAssignmentEnabled())) {
+    return;
+  }
+  frame->site_alias.resize(frame->points.size());
+  frame->site_birth_suppressed.assign(frame->points.size(), 0);
+  for (uint32_t idx = 0; idx < frame->points.size(); ++idx) {
+    frame->site_alias[idx] = idx;
+  }
+
+  if (ExactSiteIdentityEnabled() || ExactSiteBirthOwnerEnabled() ||
+      ExactSiteOwnerV2Enabled() ||
+      ConflictMultiViewBirthEnabled() ||
+      PostGeometrySiteAssignmentEnabled()) {
+    frame->exact_site_grid.reserve(frame->points.size());
+    for (uint32_t idx = 0; idx < frame->points.size(); ++idx) {
+      // Keypoints entered COLMAP as float32. Compare their float bit patterns,
+      // not rounded pixels or an epsilon neighborhood: adjacent real texture
+      // remains independent while exact DSP variants collapse deterministically
+      // to their lowest feature index.
+      frame->exact_site_grid[ExactSiteKey(frame->points[idx])].push_back(idx);
+    }
+    for (const auto& [key, members] : frame->exact_site_grid) {
+      (void)key;
+      if (members.size() <= 1) continue;
+      frame->exact_site_aliases +=
+          static_cast<uint32_t>(members.size() - 1);
+      if (ExactSiteIdentityEnabled()) {
+        const uint32_t canonical = members.front();
+        for (size_t i = 1; i < members.size(); ++i) {
+          frame->site_alias[members[i]] = canonical;
+        }
+      }
+    }
+  }
+
+  if (SiteBirthOwnerEnabled()) {
+    frame->site_grid.reserve(frame->points.size() / 2 + 1);
+    const double cell = SiteOwnerRadiusPx();
+    for (uint32_t idx = 0; idx < frame->points.size(); ++idx) {
+      const Eigen::Vector2d& xy = frame->points[idx];
+      const int gx = static_cast<int>(std::floor(xy.x() / cell));
+      const int gy = static_cast<int>(std::floor(xy.y() / cell));
+      frame->site_grid[SiteGridKey(gx, gy)].push_back(idx);
+    }
+  }
+}
