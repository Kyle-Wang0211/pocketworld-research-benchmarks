+    if (!reconstruction.ExistsImage(element.image_id)) continue;
+    const colmap::Image& image = reconstruction.Image(element.image_id);
+    if (!image.HasPose() || !image.HasCameraPtr() ||
+        element.point2D_idx >= image.NumPoints2D()) {
+      continue;
+    }
+    const Eigen::Vector3d point_cam = image.CamFromWorld() * point.xyz;
+    if (point_cam.z() <= 0.0) continue;
+    const Eigen::Vector2d pixel = image.Point2D(element.point2D_idx).xy;
+    const std::optional<Eigen::Vector2d> cam_point =
+        image.CameraPtr()->CamFromImg(pixel);
+    if (!cam_point.has_value()) continue;
+    const std::optional<Eigen::Vector2d> projected =
+        image.CameraPtr()->ImgFromCam(point_cam);
+    if (!projected.has_value()) continue;
+    const double reprojection_error = (*projected - pixel).norm();
+    reprojection_error_sum += reprojection_error;
+    max_reprojection_error =
+        std::max(max_reprojection_error, reprojection_error);
+    observations.push_back(PublishObservation{
+        image.CamFromWorld().ToMatrix(), *cam_point, pixel, image.CameraPtr(),
+        image.CamFromWorld().TgtOriginInSrc()});
+  }
+  const size_t valid_observations = observations.size();
+  if (valid_observations < PublishMinTrackLength()) return false;
+  if (reprojection_error_sum / static_cast<double>(valid_observations) >
+      PublishMaxMeanReprojectionPx()) {
+    return false;
+  }
+  if (max_reprojection_error > PublishMaxReprojectionPx()) return false;
+
+  double max_triangulation_angle = 0.0;
+  for (size_t i = 0; i < observations.size(); ++i) {
+    for (size_t j = i + 1; j < observations.size(); ++j) {
+      max_triangulation_angle =
+          std::max(max_triangulation_angle,
+                   colmap::CalculateTriangulationAngle(
+                       observations[i].camera_center,
+                       observations[j].camera_center, point.xyz));
+    }
+  }
+  if (max_triangulation_angle < PublishMinTriangulationAngleRad()) return false;
+
+  // Cross-view proof, not post-hoc deletion: hold out each observation,
+  // triangulate the internal hypothesis from all remaining views, and require
+  // that it predicts the unseen pixel. A wrong association can have a small
+  // jointly-optimized mean residual yet fail this independent prediction,
+  // which is the all-surface duplicate-layer failure mode. The hypothesis
+  // stays in the reconstruction for BA/registration either way; only this
+  // product-point allocation is withheld.
+  const double max_loo_reprojection =
+      PublishMaxLeaveOneOutReprojectionPx();
+  if (max_loo_reprojection > 0.0) {
+    std::vector<Eigen::Matrix3x4d> kept_cameras;
+    std::vector<Eigen::Vector2d> kept_points;
+    kept_cameras.reserve(observations.size() - 1);
+    kept_points.reserve(observations.size() - 1);
+    for (size_t held_out = 0; held_out < observations.size(); ++held_out) {
+      kept_cameras.clear();
+      kept_points.clear();
+      for (size_t index = 0; index < observations.size(); ++index) {
+        if (index == held_out) continue;
+        kept_cameras.push_back(observations[index].cam_from_world);
+        kept_points.push_back(observations[index].cam_point);
+      }
+      Eigen::Vector3d estimate;
+      if (!colmap::TriangulateMultiViewPoint(
+              colmap::span<const Eigen::Matrix3x4d>(kept_cameras.data(),
+                                                     kept_cameras.size()),
+              colmap::span<const Eigen::Vector2d>(kept_points.data(),
+                                                   kept_points.size()),
+              &estimate)) {
+        return false;
+      }
+      const PublishObservation& withheld = observations[held_out];
+      const Eigen::Vector3d point_cam =
+          withheld.cam_from_world.leftCols<3>() * estimate +
+          withheld.cam_from_world.col(3);
+      if (point_cam.z() <= 0.0) return false;
+      const std::optional<Eigen::Vector2d> projected =
+          withheld.camera->ImgFromCam(point_cam);
+      if (!projected.has_value() ||
+          (*projected - withheld.pixel).norm() > max_loo_reprojection) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+double ModelToCaptureMetricScale(const aether_sfm_session* s,
+                                 const colmap::Reconstruction& reconstruction) {
+  if (!s || s->frames.size() < 3) return 1.0;
+  std::vector<Eigen::Vector3d> model_centers;
+  std::vector<Eigen::Vector3d> capture_centers;
+  model_centers.reserve(s->frames.size());
+  capture_centers.reserve(s->frames.size());
+  for (const FrameRecord& frame : s->frames) {
+    if (!frame.has_pose || !reconstruction.ExistsImage(frame.image_id)) continue;
+    const colmap::Image& image = reconstruction.Image(frame.image_id);
+    if (!image.HasPose()) continue;
+    model_centers.push_back(image.CamFromWorld().TgtOriginInSrc());
+    capture_centers.push_back(frame.cam_from_world.TgtOriginInSrc());
+  }
+  if (model_centers.size() < 3) return 1.0;
+  Eigen::MatrixXd model(3, model_centers.size());
+  Eigen::MatrixXd capture(3, capture_centers.size());
+  for (size_t i = 0; i < model_centers.size(); ++i) {
+    model.col(i) = model_centers[i];
+    capture.col(i) = capture_centers[i];
+  }
+  const Eigen::Matrix4d transform = Eigen::umeyama(model, capture, true);
+  const Eigen::Matrix3d scaled_rotation = transform.block<3, 3>(0, 0);
+  const double scale =
+      (scaled_rotation.col(0).norm() + scaled_rotation.col(1).norm() +
+       scaled_rotation.col(2).norm()) /
+      3.0;
+  return std::isfinite(scale) && scale > 1e-6 ? scale : 1.0;
+}
+
+std::vector<const colmap::Point3D*> CollectPublishablePoints(
+    const colmap::Reconstruction& reconstruction,
+    const aether_sfm_session* session) {
+  struct Candidate {
+    colmap::point3D_t point_id = colmap::kInvalidPoint3DId;
+    const colmap::Point3D* point = nullptr;
+    double max_angle_rad = 0.0;
+  };
+  std::vector<Candidate> candidates;
+  candidates.reserve(reconstruction.NumPoints3D());
+  for (const auto& [point_id, point] : reconstruction.Points3D()) {
+    if (!IsPointPublishable(reconstruction, point)) continue;
+    Candidate candidate;
+    candidate.point_id = point_id;
+    candidate.point = &point;
+    std::vector<Eigen::Vector3d> centers;
+    centers.reserve(point.track.Length());
+    for (const colmap::TrackElement& element : point.track.Elements()) {
+      if (!reconstruction.ExistsImage(element.image_id)) continue;
+      const colmap::Image& image = reconstruction.Image(element.image_id);
+      if (image.HasPose()) centers.push_back(image.CamFromWorld().TgtOriginInSrc());
+    }
+    for (size_t i = 0; i < centers.size(); ++i) {
+      for (size_t j = i + 1; j < centers.size(); ++j) {
+        candidate.max_angle_rad = std::max(
+            candidate.max_angle_rad,
+            colmap::CalculateTriangulationAngle(
+                centers[i], centers[j], point.xyz));
+      }
+    }
+    candidates.push_back(candidate);
+  }
+  if (!PublishDepthConflictOwnerEnabled()) {
+    std::vector<const colmap::Point3D*> published;
+    published.reserve(candidates.size());
+    for (const Candidate& candidate : candidates) {
+      published.push_back(candidate.point);
+    }
+    return published;
+  }
+
+  // Strongest independently certified track gets first refusal at every exact
+  // image site. Same-depth candidates coexist as surface samples; a candidate
+  // separated by the registered metric-depth conflict band never receives a
+  // product point slot. Internal points remain untouched for BA/registration.
+  const bool error_first = PublishDepthOwnerErrorFirstEnabled();
+  std::sort(candidates.begin(), candidates.end(),
+            [error_first](const Candidate& a, const Candidate& b) {
+              // Restored/augmented tracks may carry COLMAP's negative
+              // "not computed" sentinel.  It is not a zero-error proof and
+              // must never outrank a measured reprojection error when the
+              // visible-point owner is chosen.
+              const double error_a =
+                  std::isfinite(a.point->error) && a.point->error >= 0.0
+                      ? a.point->error
+                      : std::numeric_limits<double>::infinity();
+              const double error_b =
+                  std::isfinite(b.point->error) && b.point->error >= 0.0
+                      ? b.point->error
+                      : std::numeric_limits<double>::infinity();
+              if (error_first && std::abs(error_a - error_b) > 1e-12) {
+                return error_a < error_b;
+              }
+              if (a.point->track.Length() != b.point->track.Length()) {
+                return a.point->track.Length() > b.point->track.Length();
+              }
+              if (std::abs(error_a - error_b) > 1e-12) {
+                return error_a < error_b;
+              }
+              if (std::abs(a.max_angle_rad - b.max_angle_rad) > 1e-12) {
+                return a.max_angle_rad > b.max_angle_rad;
+              }
+              return a.point_id < b.point_id;
+            });
+
+  struct SiteKey {
+    colmap::image_t image_id = colmap::kInvalidImageId;
+    uint64_t exact_site = 0;
+    bool operator==(const SiteKey& other) const {
+      return image_id == other.image_id && exact_site == other.exact_site;
+    }
+  };
+  struct SiteKeyHash {
+    size_t operator()(const SiteKey& key) const {
+      const size_t h1 = std::hash<colmap::image_t>{}(key.image_id);
+      const size_t h2 = std::hash<uint64_t>{}(key.exact_site);
+      return h1 ^ (h2 + 0x9e3779b97f4a7c15ULL + (h1 << 6) + (h1 >> 2));
+    }
+  };
+  std::unordered_map<SiteKey, std::vector<const Candidate*>, SiteKeyHash>
+      site_candidates;
+  site_candidates.reserve(candidates.size() * 2);
+  for (const Candidate& candidate : candidates) {
+    for (const colmap::TrackElement& element :
+         candidate.point->track.Elements()) {
+      if (!reconstruction.ExistsImage(element.image_id)) continue;
+      const colmap::Image& image = reconstruction.Image(element.image_id);
+      if (element.point2D_idx >= image.NumPoints2D()) continue;
+      const SiteKey key{element.image_id,
+                        ExactSiteKey(image.Point2D(element.point2D_idx).xy)};
+      site_candidates[key].push_back(&candidate);
+    }
+  }
+
+  const double model_to_metric_scale =
+      ModelToCaptureMetricScale(session, reconstruction);
+  const double min_depth_gap_metric = ExactSiteOwnerMinDepthGapM();
+  std::unordered_map<PointIdPair, int, PointIdPairHash> pair_evidence;
+  for (const auto& [site, members] : site_candidates) {
+    if (members.size() < 2 || !reconstruction.ExistsImage(site.image_id)) {
+      continue;
+    }
+    const colmap::Image& image = reconstruction.Image(site.image_id);
+    for (size_t i = 0; i < members.size(); ++i) {
+      const double depth_i =
+          (image.CamFromWorld() * members[i]->point->xyz).z();
+      if (depth_i <= 0.0) continue;
+      for (size_t j = i + 1; j < members.size(); ++j) {
+        if (members[i]->point_id == members[j]->point_id) continue;
+        const double depth_j =
+            (image.CamFromWorld() * members[j]->point->xyz).z();
+        if (depth_j <= 0.0 ||
+            std::abs(depth_i - depth_j) * model_to_metric_scale <
+                min_depth_gap_metric) {
+          continue;
+        }
+        ++pair_evidence[CanonicalPointPair(members[i]->point_id,
+                                           members[j]->point_id)];
+      }
+    }
+  }
+
+  std::unordered_map<colmap::point3D_t,
+                     std::vector<colmap::point3D_t>>
+      conflicts;
+  for (const auto& [pair, evidence] : pair_evidence) {
+    if (evidence < 2) continue;
+    conflicts[pair.a].push_back(pair.b);
+    conflicts[pair.b].push_back(pair.a);
+  }
+
+  std::unordered_set<colmap::point3D_t> accepted_ids;
+  accepted_ids.reserve(candidates.size());
+  std::vector<const colmap::Point3D*> published;
+  published.reserve(candidates.size());
+  for (const Candidate& candidate : candidates) {
+    bool conflict = false;
+    const auto adjacency = conflicts.find(candidate.point_id);
+    if (adjacency != conflicts.end()) {
+      for (const colmap::point3D_t other : adjacency->second) {
+        if (accepted_ids.find(other) != accepted_ids.end()) {
+          conflict = true;
+          break;
+        }
+      }
+    }
+    if (conflict) continue;
+    accepted_ids.insert(candidate.point_id);
+    published.push_back(candidate.point);
+  }
+  return published;
+}
