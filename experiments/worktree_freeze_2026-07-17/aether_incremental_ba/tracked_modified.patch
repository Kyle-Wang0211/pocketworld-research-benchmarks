+      EnvGateDouble("AETHER_EXACT_SITE_WINNER_MIN_DEPTH_M", 0.012);
+  const double max_depth_gap_m =
+      EnvGateDouble("AETHER_EXACT_SITE_WINNER_MAX_DEPTH_M", 0.100);
