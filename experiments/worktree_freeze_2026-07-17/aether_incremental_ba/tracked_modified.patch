+bool AetherExactSiteObservationAvailable(
+    const colmap::Reconstruction& reconstruction,
+    const colmap::image_t image_id,
+    const colmap::point2D_t point2D_idx,
+    const Eigen::Vector3d& candidate_xyz,
+    const colmap::point3D_t candidate_point3D_id =
+        colmap::kInvalidPoint3DId) {
+  if (!reconstruction.ExistsImage(image_id)) return false;
+  const colmap::Image& image = reconstruction.Image(image_id);
+  if (point2D_idx >= image.NumPoints2D()) return false;
+  const uint64_t site_key = ExactSiteKey(image.Point2D(point2D_idx).xy);
+  const double candidate_depth =
+      (image.CamFromWorld() * candidate_xyz).z();
+  if (candidate_depth <= 0.0) return false;
+  for (colmap::point2D_t idx = 0; idx < image.NumPoints2D(); ++idx) {
+    if (idx == point2D_idx) continue;
+    const colmap::Point2D& other = image.Point2D(idx);
+    if (!other.HasPoint3D() || ExactSiteKey(other.xy) != site_key) continue;
+    if (other.point3D_id == candidate_point3D_id) return false;
+    if (!reconstruction.ExistsPoint3D(other.point3D_id)) continue;
+    const double owner_depth =
+        (image.CamFromWorld() *
+         reconstruction.Point3D(other.point3D_id).xyz)
+            .z();
+    if (owner_depth > 0.0 &&
+        std::abs(candidate_depth - owner_depth) >=
+            ExactSiteOwnerMinDepthGapM()) {
+      return false;
+    }
+  }
+  return true;
+}
