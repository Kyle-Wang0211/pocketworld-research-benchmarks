+// Resolve geometrically verified descriptor matches onto physical image sites.
+// Raw descriptor variants have already done their job in RANSAC by the time
+// this runs.  Evidence for the same site pair is aggregated, then a maximum-
+// weight bipartite assignment enforces one physical observation per endpoint.
+// The primary score is independent orientation/scale support; descriptor dot
+// product breaks ties.  No image, feature, or born Point3D is deleted.
+void AssignPostGeometryPhysicalSites(
+    const FrameRecord& frame1, const FrameRecord& frame2,
+    colmap::FeatureMatches* inliers, PostGeometrySiteStats* out_stats) {
+  PostGeometrySiteStats stats;
+  if (!inliers || inliers->empty()) {
+    if (out_stats) *out_stats = stats;
+    return;
+  }
+  stats.input_inliers = static_cast<int64_t>(inliers->size());
+
+  struct EdgeEvidence {
+    uint32_t site1 = 0;
+    uint32_t site2 = 0;
+    int64_t support = 0;
+    int64_t max_dot = 0;
+  };
+  std::unordered_map<uint64_t, EdgeEvidence> evidence;
+  std::unordered_map<uint32_t, std::vector<uint32_t>> adjacency1;
+  std::unordered_map<uint32_t, std::vector<uint32_t>> adjacency2;
+  evidence.reserve(inliers->size());
+  adjacency1.reserve(inliers->size());
+  adjacency2.reserve(inliers->size());
+  for (const colmap::FeatureMatch& match : *inliers) {
+    if (match.point2D_idx1 >= frame1.points.size() ||
+        match.point2D_idx2 >= frame2.points.size()) {
+      continue;
+    }
+    const uint32_t site1 =
+        CanonicalPhysicalSite(frame1, match.point2D_idx1);
+    const uint32_t site2 =
+        CanonicalPhysicalSite(frame2, match.point2D_idx2);
+    const uint64_t key = (static_cast<uint64_t>(site1) << 32) | site2;
+    auto [it, inserted] = evidence.emplace(
+        key, EdgeEvidence{site1, site2, 0, 0});
+    EdgeEvidence& edge = it->second;
+    ++edge.support;
+    edge.max_dot = std::max(
+        edge.max_dot,
+        CrossFrameDescriptorDot(frame1, match.point2D_idx1, frame2,
+                                match.point2D_idx2));
+    if (inserted) {
+      adjacency1[site1].push_back(site2);
+      adjacency2[site2].push_back(site1);
+    }
+  }
+  stats.unique_edges = static_cast<int64_t>(evidence.size());
+
+  std::unordered_set<uint32_t> remaining;
+  remaining.reserve(adjacency1.size());
+  for (const auto& [site, neighbors] : adjacency1) {
+    (void)neighbors;
+    remaining.insert(site);
+  }
+
+  colmap::FeatureMatches assigned;
+  assigned.reserve(std::min(adjacency1.size(), adjacency2.size()));
+  constexpr int64_t kSupportWeight = 1000000;
+  while (!remaining.empty()) {
+    const uint32_t first =
+        *std::min_element(remaining.begin(), remaining.end());
+    std::vector<std::pair<int, uint32_t>> stack{{0, first}};
+    std::unordered_set<uint32_t> component1;
+    std::unordered_set<uint32_t> component2;
+    while (!stack.empty()) {
+      const auto [side, site] = stack.back();
+      stack.pop_back();
+      if (side == 0) {
+        if (!component1.insert(site).second) continue;
+        const auto neighbors = adjacency1.find(site);
+        if (neighbors != adjacency1.end()) {
+          for (const uint32_t other : neighbors->second) {
+            stack.emplace_back(1, other);
+          }
+        }
+      } else {
+        if (!component2.insert(site).second) continue;
+        const auto neighbors = adjacency2.find(site);
+        if (neighbors != adjacency2.end()) {
+          for (const uint32_t other : neighbors->second) {
+            stack.emplace_back(0, other);
+          }
+        }
+      }
+    }
+    for (const uint32_t site : component1) remaining.erase(site);
+
+    std::vector<uint32_t> rows(component1.begin(), component1.end());
+    std::vector<uint32_t> cols(component2.begin(), component2.end());
+    std::sort(rows.begin(), rows.end());
+    std::sort(cols.begin(), cols.end());
+    const size_t size = std::max(rows.size(), cols.size());
+    stats.max_component =
+        std::max(stats.max_component, static_cast<int64_t>(size));
+    if (size == 0) continue;
+
+    std::unordered_map<uint32_t, size_t> col_index;
+    col_index.reserve(cols.size());
+    for (size_t col = 0; col < cols.size(); ++col) {
+      col_index.emplace(cols[col], col);
+    }
+    std::vector<int64_t> weights(size * size, 0);
+    int64_t max_weight = 0;
+    for (size_t row = 0; row < rows.size(); ++row) {
+      const auto neighbors = adjacency1.find(rows[row]);
+      if (neighbors == adjacency1.end()) continue;
+      for (const uint32_t site2 : neighbors->second) {
+        const auto col = col_index.find(site2);
+        if (col == col_index.end()) continue;
+        const uint64_t key =
+            (static_cast<uint64_t>(rows[row]) << 32) | site2;
+        const EdgeEvidence& edge = evidence.at(key);
+        const int64_t weight = edge.support * kSupportWeight + edge.max_dot;
+        weights[row * size + col->second] = weight;
+        max_weight = std::max(max_weight, weight);
+      }
+    }
+
+    // Deterministic square Hungarian assignment. Padding rows/columns have
+    // zero weight, allowing either side of a rectangular component to remain
+    // unmatched. Minimizing (max_weight - weight) maximizes total evidence.
+    std::vector<int64_t> u(size + 1, 0), v(size + 1, 0);
+    std::vector<size_t> p(size + 1, 0), way(size + 1, 0);
+    for (size_t i = 1; i <= size; ++i) {
+      p[0] = i;
+      size_t j0 = 0;
+      std::vector<int64_t> minv(
+          size + 1, std::numeric_limits<int64_t>::max() / 4);
+      std::vector<bool> used(size + 1, false);
+      do {
+        used[j0] = true;
+        const size_t i0 = p[j0];
+        int64_t delta = std::numeric_limits<int64_t>::max() / 4;
+        size_t j1 = 0;
+        for (size_t j = 1; j <= size; ++j) {
+          if (used[j]) continue;
+          const int64_t cost =
+              max_weight - weights[(i0 - 1) * size + (j - 1)];
+          const int64_t cur = cost - u[i0] - v[j];
+          if (cur < minv[j]) {
+            minv[j] = cur;
+            way[j] = j0;
+          }
+          if (minv[j] < delta ||
+              (minv[j] == delta && (j1 == 0 || j < j1))) {
+            delta = minv[j];
+            j1 = j;
+          }
+        }
+        for (size_t j = 0; j <= size; ++j) {
+          if (used[j]) {
+            u[p[j]] += delta;
+            v[j] -= delta;
+          } else {
+            minv[j] -= delta;
+          }
+        }
+        j0 = j1;
+      } while (p[j0] != 0);
+      do {
+        const size_t j1 = way[j0];
+        p[j0] = p[j1];
+        j0 = j1;
+      } while (j0 != 0);
+    }
+    for (size_t col = 1; col <= size; ++col) {
+      const size_t row = p[col];
+      if (row == 0 || row > rows.size() || col > cols.size()) continue;
+      if (weights[(row - 1) * size + (col - 1)] <= 0) continue;
+      assigned.push_back(colmap::FeatureMatch{rows[row - 1], cols[col - 1]});
+    }
+  }
+
+  std::sort(assigned.begin(), assigned.end(),
+            [](const colmap::FeatureMatch& a,
+               const colmap::FeatureMatch& b) {
+              if (a.point2D_idx1 != b.point2D_idx1) {
+                return a.point2D_idx1 < b.point2D_idx1;
+              }
+              return a.point2D_idx2 < b.point2D_idx2;
+            });
+  stats.assigned_inliers = static_cast<int64_t>(assigned.size());
+  *inliers = std::move(assigned);
+  if (out_stats) *out_stats = stats;
+}
+
+struct NearbySiteOwner {
+  uint32_t feature_idx = 0;
+  double distance_px = std::numeric_limits<double>::infinity();
+  double descriptor_cosine = -1.0;
+};
+
+using NearbySiteOwners =
+    std::unordered_map<colmap::point3D_t, NearbySiteOwner>;
+
+// Return the already-assigned feature that owns query_idx's bit-identical
+// physical site. An assigned query keeps its own identity so two pre-existing
+// tracks still reach the conservative merge gate instead of one being hidden.
+// For an unassigned query, prefer the longest established track; deterministic
+// ids break ties. This changes topology only for exact float32 x/y duplicates.
+std::optional<uint32_t> FindExactSiteOwnerV2Feature(
+    const colmap::Reconstruction& recon, const FrameRecord& frame,
+    const uint32_t query_idx) {
+  if (!ExactSiteOwnerV2Enabled() || query_idx >= frame.points.size() ||
+      frame.exact_site_grid.empty() || !recon.ExistsImage(frame.image_id)) {
+    return std::nullopt;
+  }
+  const colmap::Image& image = recon.Image(frame.image_id);
+  if (query_idx < image.NumPoints2D() &&
+      image.Point2D(query_idx).HasPoint3D()) {
+    return query_idx;
+  }
+  const auto bucket =
+      frame.exact_site_grid.find(ExactSiteKey(frame.points[query_idx]));
+  if (bucket == frame.exact_site_grid.end()) return std::nullopt;
+
+  std::optional<uint32_t> best;
+  size_t best_views = 0;
+  colmap::point3D_t best_point =
+      std::numeric_limits<colmap::point3D_t>::max();
+  for (const uint32_t candidate_idx : bucket->second) {
+    if (candidate_idx >= image.NumPoints2D()) continue;
+    const colmap::Point2D& observation = image.Point2D(candidate_idx);
+    if (!observation.HasPoint3D() ||
+        !recon.ExistsPoint3D(observation.point3D_id)) {
+      continue;
+    }
+    const size_t views = recon.Point3D(observation.point3D_id).track.Length();
+    if (!best || views > best_views ||
+        (views == best_views &&
+         (observation.point3D_id < best_point ||
+          (observation.point3D_id == best_point && candidate_idx < *best)))) {
+      best = candidate_idx;
+      best_views = views;
+      best_point = observation.point3D_id;
+    }
+  }
+  return best;
+}
+
+// Once a Point3D owns an exact image site, alias every still-unassigned SIFT
+// variant at that site to the owner. Assigned variants are deliberately left
+// intact so an accidental pre-existing duplicate can still be adjudicated by
+// the normal merge gate. Returns the number of newly claimed feature ids.
+int64_t ClaimExactSiteOwnerV2Aliases(
+    const colmap::Reconstruction& recon, FrameRecord* frame,
+    const uint32_t owner_idx) {
+  if (!ExactSiteOwnerV2Enabled() || !frame ||
+      owner_idx >= frame->points.size() ||
+      frame->exact_site_grid.empty() ||
+      !recon.ExistsImage(frame->image_id)) {
+    return 0;
+  }
+  const colmap::Image& image = recon.Image(frame->image_id);
+  if (owner_idx >= image.NumPoints2D() ||
+      !image.Point2D(owner_idx).HasPoint3D()) {
+    return 0;
+  }
+  const auto bucket =
+      frame->exact_site_grid.find(ExactSiteKey(frame->points[owner_idx]));
+  if (bucket == frame->exact_site_grid.end()) return 0;
+  int64_t claimed = 0;
+  for (const uint32_t member : bucket->second) {
+    if (member == owner_idx || member >= frame->site_alias.size() ||
+        member >= image.NumPoints2D()) {
+      continue;
+    }
+    if (image.Point2D(member).HasPoint3D()) continue;
+    if (frame->site_alias[member] != owner_idx) {
+      frame->site_alias[member] = owner_idx;
+      ++claimed;
+    }
+  }
+  return claimed;
+}
+
+NearbySiteOwners FindExactSiteOwners(const colmap::Reconstruction& recon,
+                                     const FrameRecord& frame,
+                                     const uint32_t query_idx) {
+  NearbySiteOwners owners;
+  if (!ExactSiteBirthOwnerEnabled() || query_idx >= frame.points.size() ||
+      frame.exact_site_grid.empty() || !recon.ExistsImage(frame.image_id)) {
+    return owners;
+  }
+  const auto bucket =
+      frame.exact_site_grid.find(ExactSiteKey(frame.points[query_idx]));
+  if (bucket == frame.exact_site_grid.end()) return owners;
+  const colmap::Image& image = recon.Image(frame.image_id);
+  for (const uint32_t candidate_idx : bucket->second) {
+    if (candidate_idx == query_idx || candidate_idx >= image.NumPoints2D()) {
+      continue;
+    }
+    const colmap::Point2D& observation = image.Point2D(candidate_idx);
+    if (!observation.HasPoint3D() ||
+        !recon.ExistsPoint3D(observation.point3D_id)) {
+      continue;
+    }
+    const colmap::Point3D& point = recon.Point3D(observation.point3D_id);
+    if (point.track.Length() <
+        static_cast<size_t>(SiteOwnerMinTrackViews())) {
+      continue;
+    }
+    const double cosine =
+        SiteDescriptorCosine(frame, query_idx, candidate_idx);
+    auto [it, inserted] = owners.emplace(
+        observation.point3D_id,
+        NearbySiteOwner{candidate_idx, 0.0, cosine});
+    if (!inserted &&
+        (cosine > it->second.descriptor_cosine + 1e-12 ||
+         (std::abs(cosine - it->second.descriptor_cosine) <= 1e-12 &&
+          candidate_idx < it->second.feature_idx))) {
+      it->second = NearbySiteOwner{candidate_idx, 0.0, cosine};
+    }
+  }
+  return owners;
+}
+
+NearbySiteOwners FindNearbySiteOwners(const colmap::Reconstruction& recon,
+                                      const FrameRecord& frame,
+                                      const uint32_t query_idx) {
+  NearbySiteOwners owners;
+  if (!SiteBirthOwnerEnabled() || query_idx >= frame.points.size() ||
+      frame.site_grid.empty() || !recon.ExistsImage(frame.image_id)) {
+    return owners;
+  }
+  const double radius = SiteOwnerRadiusPx();
+  const double radius2 = radius * radius;
+  const Eigen::Vector2d& query = frame.points[query_idx];
+  const int qx = static_cast<int>(std::floor(query.x() / radius));
+  const int qy = static_cast<int>(std::floor(query.y() / radius));
+  const colmap::Image& image = recon.Image(frame.image_id);
+  for (int dx = -1; dx <= 1; ++dx) {
+    for (int dy = -1; dy <= 1; ++dy) {
+      const auto bucket = frame.site_grid.find(SiteGridKey(qx + dx, qy + dy));
+      if (bucket == frame.site_grid.end()) continue;
+      for (const uint32_t candidate_idx : bucket->second) {
+        if (candidate_idx == query_idx || candidate_idx >= image.NumPoints2D()) {
+          continue;
+        }
+        const Eigen::Vector2d delta = frame.points[candidate_idx] - query;
+        const double distance2 = delta.squaredNorm();
+        if (distance2 > radius2) continue;
+        const colmap::Point2D& observation = image.Point2D(candidate_idx);
+        if (!observation.HasPoint3D() ||
+            !recon.ExistsPoint3D(observation.point3D_id)) {
+          continue;
+        }
+        const colmap::Point3D& point = recon.Point3D(observation.point3D_id);
+        if (point.track.Length() <
+            static_cast<size_t>(SiteOwnerMinTrackViews())) {
+          continue;
+        }
+        const double cosine =
+            SiteDescriptorCosine(frame, query_idx, candidate_idx);
+        if (cosine < SiteOwnerMinCosine()) continue;
+        const double distance = std::sqrt(distance2);
+        auto [it, inserted] = owners.emplace(
+            observation.point3D_id,
+            NearbySiteOwner{candidate_idx, distance, cosine});
+        if (!inserted &&
+            (cosine > it->second.descriptor_cosine + 1e-12 ||
+             (std::abs(cosine - it->second.descriptor_cosine) <= 1e-12 &&
+              distance < it->second.distance_px))) {
+          it->second = NearbySiteOwner{candidate_idx, distance, cosine};
+        }
+      }
+    }
+  }
+  return owners;
+}
+
+struct SiteOwnerDecision {
+  colmap::point3D_t point3D_id =
+      std::numeric_limits<colmap::point3D_t>::max();
+  uint32_t feature_idx1 = 0;
+  uint32_t feature_idx2 = 0;
+  double min_cosine = -1.0;
+  double mean_cosine = -1.0;
+  double distance_sum = std::numeric_limits<double>::infinity();
+  size_t track_views = 0;
+};
+
+std::optional<SiteOwnerDecision> SelectCommonExactSiteOwner(
+    const colmap::Reconstruction& recon, const FrameRecord& frame1,
+    const uint32_t idx1, const FrameRecord& frame2, const uint32_t idx2) {
+  const NearbySiteOwners owners1 = FindExactSiteOwners(recon, frame1, idx1);
+  const NearbySiteOwners owners2 = FindExactSiteOwners(recon, frame2, idx2);
+  if (owners1.empty() || owners2.empty()) return std::nullopt;
+
+  std::optional<SiteOwnerDecision> best;
+  for (const auto& [point_id, owner1] : owners1) {
+    const auto second = owners2.find(point_id);
+    if (second == owners2.end() || !recon.ExistsPoint3D(point_id)) continue;
+    const NearbySiteOwner& owner2 = second->second;
+    SiteOwnerDecision decision;
+    decision.point3D_id = point_id;
+    decision.feature_idx1 = owner1.feature_idx;
+    decision.feature_idx2 = owner2.feature_idx;
+    decision.min_cosine =
+        std::min(owner1.descriptor_cosine, owner2.descriptor_cosine);
+    decision.mean_cosine =
+        0.5 * (owner1.descriptor_cosine + owner2.descriptor_cosine);
+    decision.distance_sum = 0.0;
+    decision.track_views = recon.Point3D(point_id).track.Length();
+    const bool better =
+        !best || decision.track_views > best->track_views ||
+        (decision.track_views == best->track_views &&
+         (decision.mean_cosine > best->mean_cosine + 1e-12 ||
+          (std::abs(decision.mean_cosine - best->mean_cosine) <= 1e-12 &&
+           decision.point3D_id < best->point3D_id)));
+    if (better) best = decision;
+  }
+  return best;
+}
+
+std::optional<SiteOwnerDecision> SelectCommonSiteOwner(
+    const colmap::Reconstruction& recon, const FrameRecord& frame1,
+    const uint32_t idx1, const FrameRecord& frame2, const uint32_t idx2) {
+  const NearbySiteOwners owners1 = FindNearbySiteOwners(recon, frame1, idx1);
+  const NearbySiteOwners owners2 = FindNearbySiteOwners(recon, frame2, idx2);
+  if (owners1.empty() || owners2.empty()) return std::nullopt;
+
+  std::optional<SiteOwnerDecision> best;
+  for (const auto& [point_id, owner1] : owners1) {
+    const auto second = owners2.find(point_id);
+    if (second == owners2.end() || !recon.ExistsPoint3D(point_id)) continue;
+    const NearbySiteOwner& owner2 = second->second;
+    SiteOwnerDecision decision;
+    decision.point3D_id = point_id;
+    decision.feature_idx1 = owner1.feature_idx;
+    decision.feature_idx2 = owner2.feature_idx;
+    decision.min_cosine =
+        std::min(owner1.descriptor_cosine, owner2.descriptor_cosine);
+    decision.mean_cosine =
+        0.5 * (owner1.descriptor_cosine + owner2.descriptor_cosine);
+    decision.distance_sum = owner1.distance_px + owner2.distance_px;
+    decision.track_views = recon.Point3D(point_id).track.Length();
+    if (decision.min_cosine < SiteOwnerMinCosine() ||
+        decision.mean_cosine < SiteOwnerMeanCosine()) {
+      continue;
+    }
+    const bool better =
+        !best || decision.min_cosine > best->min_cosine + 1e-12 ||
+        (std::abs(decision.min_cosine - best->min_cosine) <= 1e-12 &&
+         (decision.mean_cosine > best->mean_cosine + 1e-12 ||
+          (std::abs(decision.mean_cosine - best->mean_cosine) <= 1e-12 &&
+           (decision.distance_sum < best->distance_sum - 1e-12 ||
+            (std::abs(decision.distance_sum - best->distance_sum) <= 1e-12 &&
+             (decision.track_views > best->track_views ||
+              (decision.track_views == best->track_views &&
+               decision.point3D_id < best->point3D_id)))))));
+    if (better) best = decision;
+  }
+  return best;
+}
+
+bool CanonicalizeSiteOwnerMatches(const FrameRecord& frame1,
+                                  const FrameRecord& frame2,
+                                  colmap::FeatureMatches* matches,
+                                  int64_t* rewrites,
+                                  int64_t* deduplicated) {
+  if (!matches || matches->empty()) return false;
+  if (ExactSiteIdentityEnabled()) {
+    struct Candidate {
+      colmap::FeatureMatch raw;
+      colmap::FeatureMatch canonical;
+      double score = -1.0;
+    };
+    std::vector<Candidate> candidates;
+    candidates.reserve(matches->size());
+    bool changed = false;
+    for (const colmap::FeatureMatch& match : *matches) {
+      if ((match.point2D_idx1 < frame1.site_birth_suppressed.size() &&
+           frame1.site_birth_suppressed[match.point2D_idx1]) ||
+          (match.point2D_idx2 < frame2.site_birth_suppressed.size() &&
+           frame2.site_birth_suppressed[match.point2D_idx2])) {
+        changed = true;
+        if (deduplicated) ++*deduplicated;
+        continue;
+      }
+      Candidate candidate;
+      candidate.raw = match;
+      candidate.canonical = match;
+      candidate.canonical.point2D_idx1 =
+          ResolveSiteAlias(frame1, match.point2D_idx1);
+      candidate.canonical.point2D_idx2 =
+          ResolveSiteAlias(frame2, match.point2D_idx2);
+      candidate.score = CrossFrameDescriptorCosine(
+          frame1, match.point2D_idx1, frame2, match.point2D_idx2);
+      if (candidate.canonical.point2D_idx1 != match.point2D_idx1 ||
+          candidate.canonical.point2D_idx2 != match.point2D_idx2) {
+        changed = true;
+        if (rewrites) ++*rewrites;
+      }
+      candidates.push_back(candidate);
+    }
+    // Several descriptor variants at one pixel may each be mutual-best against
+    // different variants in the other image. Select the strongest raw evidence
+    // first, then enforce one-to-one ownership on canonical pixel identities.
+    // Ties are fully deterministic so the same DB/config produces the same graph.
+    std::sort(candidates.begin(), candidates.end(),
+              [](const Candidate& a, const Candidate& b) {
+                if (std::abs(a.score - b.score) > 1e-12) {
+                  return a.score > b.score;
+                }
+                if (a.canonical.point2D_idx1 != b.canonical.point2D_idx1) {
+                  return a.canonical.point2D_idx1 < b.canonical.point2D_idx1;
+                }
+                if (a.canonical.point2D_idx2 != b.canonical.point2D_idx2) {
+                  return a.canonical.point2D_idx2 < b.canonical.point2D_idx2;
+                }
+                if (a.raw.point2D_idx1 != b.raw.point2D_idx1) {
+                  return a.raw.point2D_idx1 < b.raw.point2D_idx1;
+                }
+                return a.raw.point2D_idx2 < b.raw.point2D_idx2;
+              });
+    std::unordered_set<uint32_t> used1;
+    std::unordered_set<uint32_t> used2;
+    used1.reserve(candidates.size());
+    used2.reserve(candidates.size());
+    colmap::FeatureMatches canonical;
+    canonical.reserve(candidates.size());
+    for (const Candidate& candidate : candidates) {
+      if (used1.find(candidate.canonical.point2D_idx1) != used1.end() ||
+          used2.find(candidate.canonical.point2D_idx2) != used2.end()) {
+        changed = true;
+        if (deduplicated) ++*deduplicated;
+        continue;
+      }
+      used1.insert(candidate.canonical.point2D_idx1);
+      used2.insert(candidate.canonical.point2D_idx2);
+      canonical.push_back(candidate.canonical);
+    }
+    if (changed) *matches = std::move(canonical);
+    return changed;
+  }
+
+  bool changed = false;
+  std::unordered_set<uint64_t> seen;
+  seen.reserve(matches->size());
+  colmap::FeatureMatches canonical;
+  canonical.reserve(matches->size());
+  for (const colmap::FeatureMatch& match : *matches) {
+    if ((match.point2D_idx1 < frame1.site_birth_suppressed.size() &&
+         frame1.site_birth_suppressed[match.point2D_idx1]) ||
+        (match.point2D_idx2 < frame2.site_birth_suppressed.size() &&
+         frame2.site_birth_suppressed[match.point2D_idx2])) {
+      changed = true;
+      if (deduplicated) ++*deduplicated;
+      continue;
+    }
+    colmap::FeatureMatch rewritten = match;
+    rewritten.point2D_idx1 =
+        ResolveSiteAlias(frame1, rewritten.point2D_idx1);
+    rewritten.point2D_idx2 =
+        ResolveSiteAlias(frame2, rewritten.point2D_idx2);
+    if (rewritten.point2D_idx1 != match.point2D_idx1 ||
+        rewritten.point2D_idx2 != match.point2D_idx2) {
+      changed = true;
+      if (rewrites) ++*rewrites;
+    }
+    const uint64_t key =
+        (static_cast<uint64_t>(rewritten.point2D_idx1) << 32) |
