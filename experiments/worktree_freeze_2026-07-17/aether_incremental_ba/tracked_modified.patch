+// V5: preserve the raw graph unless two independently verified components at
+// one exact image site both triangulate cleanly but land at materially different
+// depths. The stronger component keeps all of its original observations; the
+// weaker component is prevented from entering finalize triangulation. Crucially,
+// no losing edge is redirected into the winner, avoiding the mixed-track plane
+// damage seen in V3/V4.
+template <typename GeometryRows>
+ExactSiteRiskStats SelectGeometricExactSiteWinners(
+    aether_sfm_session* s, const GeometryRows& geometries,
+    const colmap::Reconstruction* pose_model) {
+  ExactSiteRiskStats stats;
+  if (!s || !ExactSiteGeometricWinnerEnabled()) return stats;
+
+  struct Observation {
+    colmap::image_t image_id = 0;
+    uint32_t feature_idx = 0;
+  };
+  struct DisjointSet {
+    std::vector<size_t> parent;
+    std::vector<uint8_t> rank;
+    size_t Add() {
+      const size_t index = parent.size();
+      parent.push_back(index);
+      rank.push_back(0);
+      return index;
+    }
+    size_t Find(size_t value) {
+      size_t root = value;
+      while (parent[root] != root) root = parent[root];
+      while (parent[value] != value) {
+        const size_t next = parent[value];
+        parent[value] = root;
+        value = next;
+      }
+      return root;
+    }
+    void Union(size_t a, size_t b) {
+      a = Find(a);
+      b = Find(b);
+      if (a == b) return;
+      if (rank[a] < rank[b]) std::swap(a, b);
+      parent[b] = a;
+      if (rank[a] == rank[b]) ++rank[a];
+    }
+  } dsu;
+
+  auto observation_key = [](const colmap::image_t image_id,
+                            const uint32_t feature_idx) {
+    return (static_cast<uint64_t>(image_id) << 32) |
+           static_cast<uint64_t>(feature_idx);
+  };
+  std::unordered_map<uint64_t, size_t> node_index;
+  node_index.reserve(geometries.size() * 64);
+  std::vector<Observation> node_observations;
+  auto node = [&](const colmap::image_t image_id,
+                  const uint32_t feature_idx) {
+    const uint64_t key = observation_key(image_id, feature_idx);
+    const auto found = node_index.find(key);
+    if (found != node_index.end()) return found->second;
+    const size_t index = dsu.Add();
+    node_index.emplace(key, index);
+    node_observations.push_back({image_id, feature_idx});
+    return index;
+  };
+  for (const auto& [pair_id, geometry] : geometries) {
+    const auto [image_id1, image_id2] = colmap::PairIdToImagePair(pair_id);
+    for (const colmap::FeatureMatch& match : geometry.inlier_matches) {
+      dsu.Union(node(image_id1, match.point2D_idx1),
+                node(image_id2, match.point2D_idx2));
+    }
+  }
+
+  std::unordered_map<size_t, std::vector<Observation>> root_observations;
+  root_observations.reserve(node_observations.size() / 2 + 1);
+  for (size_t index = 0; index < node_observations.size(); ++index) {
+    root_observations[dsu.Find(index)].push_back(node_observations[index]);
+  }
+  std::unordered_map<colmap::image_t, FrameRecord*> frame_by_image;
+  frame_by_image.reserve(s->frames.size());
+  for (FrameRecord& frame : s->frames) {
+    frame_by_image.emplace(frame.image_id, &frame);
+    std::fill(frame.site_alias.begin(), frame.site_alias.end(), 0);
+    for (uint32_t idx = 0; idx < frame.site_alias.size(); ++idx) {
+      frame.site_alias[idx] = idx;
+    }
+    frame.site_birth_suppressed.assign(frame.points.size(), 0);
+  }
+
+  struct Geometry {
+    bool valid = false;
+    int views = 0;
+    double rms_reproj_px = std::numeric_limits<double>::infinity();
+    double max_reproj_px = std::numeric_limits<double>::infinity();
+    double max_angle_rad = 0.0;
+    Eigen::Vector3d xyz = Eigen::Vector3d::Zero();
+  };
