+bool SameExactImageSite(const Point2D& a, const Point2D& b) {
+  return a.xy.x() == b.xy.x() && a.xy.y() == b.xy.y();
+}
+
+bool ExactImageSiteHasDepthConflict(const Reconstruction& reconstruction,
+                                    const image_t image_id,
+                                    const point2D_t point2D_idx,
+                                    const Eigen::Vector3d& candidate_xyz,
+                                    const double min_depth_gap,
+                                    const point3D_t candidate_point3D_id =
+                                        kInvalidPoint3DId) {
+  if (!reconstruction.ExistsImage(image_id)) return true;
+  const Image& image = reconstruction.Image(image_id);
+  if (point2D_idx >= image.NumPoints2D()) return true;
+  const Point2D& candidate = image.Point2D(point2D_idx);
+  const double candidate_depth =
+      (image.CamFromWorld() * candidate_xyz).z();
+  if (candidate_depth <= 0.0) return true;
+  for (point2D_t idx = 0; idx < image.NumPoints2D(); ++idx) {
+    if (idx == point2D_idx) continue;
+    const Point2D& other = image.Point2D(idx);
+    if (!other.HasPoint3D() || !SameExactImageSite(candidate, other)) continue;
+    if (other.point3D_id == candidate_point3D_id) return true;
+    if (!reconstruction.ExistsPoint3D(other.point3D_id)) continue;
+    const double other_depth =
+        (image.CamFromWorld() * reconstruction.Point3D(other.point3D_id).xyz)
+            .z();
+    if (other_depth > 0.0 &&
+        std::abs(candidate_depth - other_depth) >= min_depth_gap) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool ExactImageSitesDepthCompatible(const Reconstruction& reconstruction,
+                                    const Track& track,
+                                    const Eigen::Vector3d& candidate_xyz,
+                                    const double min_depth_gap) {
+  for (const TrackElement& element : track.Elements()) {
+    if (ExactImageSiteHasDepthConflict(reconstruction,
+                                       element.image_id,
+                                       element.point2D_idx,
+                                       candidate_xyz,
+                                       min_depth_gap)) {
+      return false;
+    }
+  }
+  return true;
+}
