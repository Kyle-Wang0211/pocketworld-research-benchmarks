+// [E12 STAGE2 FINE KNIFE 2026-07-19] Per-observation transfer gate chain,
+// SYNTHESIS v2 S5 order: one-obs-per-image dedup -> positive depth ->
+// reprojection at the winner's triangulated position (<= 4 px certified
+// cross-layer physics, E8/E11) -> viewing cone < 60 deg (anti two-sided
+// fusion). The SINGLE source of gate truth for both the birth-time union
+// branch and alias-routed track growth; a failing observation is dropped,
+// never seeded into a second point.
+enum class Stage2TransferVerdict { kOk, kDupImage, kDepth, kReproj, kAngle };
 
+Stage2TransferVerdict EvaluateStage2Transfer(
+    const colmap::Reconstruction& recon,
+    const colmap::Camera& camera,
+    const colmap::point3D_t pid,
+    const colmap::image_t obs_image_id,
+    const colmap::Rigid3d& obs_cam_from_world,
+    const Eigen::Vector2d& obs_kp) {
+  const colmap::Point3D& p3d = recon.Point3D(pid);
+  for (const colmap::TrackElement& el : p3d.track.Elements()) {
+    if (el.image_id == obs_image_id) return Stage2TransferVerdict::kDupImage;
+  }
+  const Eigen::Vector3d X_c = obs_cam_from_world * p3d.xyz;
+  if (X_c.z() <= 0.0) return Stage2TransferVerdict::kDepth;
+  const std::optional<Eigen::Vector2d> pr = camera.ImgFromCam(X_c);
+  if (!pr || (*pr - obs_kp).norm() > Stage2TransferMaxReprojPx()) {
+    return Stage2TransferVerdict::kReproj;
+  }
+  // Mean viewing direction (unit point->camera rays) over the current track.
+  // A degenerate direction sum fails OPEN: the reproj gate above remains the
+  // binding constraint and rejecting on numerical noise would be arbitrary.
+  Eigen::Vector3d mean_dir = Eigen::Vector3d::Zero();
+  for (const colmap::TrackElement& el : p3d.track.Elements()) {
+    if (!recon.ExistsImage(el.image_id)) continue;
+    const Eigen::Vector3d cc =
+        recon.Image(el.image_id).CamFromWorld().TgtOriginInSrc();
+    const double n = (cc - p3d.xyz).norm();
+    if (n > 1e-12) mean_dir += (cc - p3d.xyz) / n;
+  }
+  if (mean_dir.norm() > 1e-9) {
+    mean_dir.normalize();
+    const Eigen::Vector3d cc = obs_cam_from_world.TgtOriginInSrc();
+    const double n = (cc - p3d.xyz).norm();
+    if (n > 1e-12 &&
+        ((cc - p3d.xyz) / n).dot(mean_dir) < Stage2TransferMinCosAngle()) {
+      return Stage2TransferVerdict::kAngle;
+    }
+  }
+  return Stage2TransferVerdict::kOk;
+}
