+// ORB-SLAM2 KeyFrame::ComputeSceneMedianDepth(q=2) transplanted onto the
+// colmap Reconstruction: median z-depth, in the given camera frame, over the
+// scene points currently observed by that image. Returns <=0 when the image
+// observes no triangulated points yet (bootstrap) — the caller must then
+// ALLOW birth: no scene scale exists to price parallax against, exactly like
+// ORB-SLAM whose gate only runs after map initialization.
+double M2MedianSceneDepth(const colmap::Reconstruction& recon,
+                          colmap::image_t image_id,
+                          const colmap::Rigid3d& cam_from_world) {
+  if (!recon.ExistsImage(image_id)) return -1.0;
+  const colmap::Image& image = recon.Image(image_id);
+  std::vector<double> depths;
+  depths.reserve(image.NumPoints3D());
+  for (const colmap::Point2D& point2D : image.Points2D()) {
+    if (!point2D.HasPoint3D()) continue;
+    const Eigen::Vector3d x_cam =
+        cam_from_world * recon.Point3D(point2D.point3D_id).xyz;
+    if (x_cam.z() > 0.0) depths.push_back(x_cam.z());
+  }
+  if (depths.empty()) return -1.0;
+  const size_t mid = (depths.size() - 1) / 2;  // ORB-SLAM vDepths[(N-1)/q], q=2
+  std::nth_element(depths.begin(), depths.begin() + mid, depths.end());
+  return depths[mid];
 }
 
