e var lastState: Int32 = 0\\n'\n            '    private var lastPose = PWXrslamRawPose()\\n'\n            '    private var cameraCallbacks: UInt64 = 0\\n'\n            '    private var cameraLockFailures: UInt64 = 0\\n'\n            '\\n'\n            '    // ── 有界入队 + 串行 worker(抄生产 PwVioSlamFeeder)────────────────────\\n'\n            '    /// 算法只在这条队列上跑。回调**绝不**在这里等。\\n'\n            '    private let workQueue = DispatchQueue(\\n'\n            '        label: \"com.pocketworld.xrslam.live.work\", qos: .userInitiated)\\n'\n            '\\n'\n            '    /// 相机在途帧数上限。取 2:一帧在算、一帧在等。\\n'\n            '    /// 🔴 不能大 —— 每一帧都 retain 着一个 AVFoundation 池里的\\n'\n            '    ///    `CVPixelBuffer`(1920×1440 BGRA ≈ 11 MB)。押太多帧,采集端会\\n'\n            '    ///    `out_of_buffers`,那是把丢帧从我们的闸上推回给系统,归因就没了。\\n'\n            '    private static let maxPendingFrames = 2\\n'\n            '    /// IMU 在途上限。100 Hz × 4 s —— 只在 worker 被长时间占住时才会命中。\\n'\n            '    private static let maxPendingImu = 400\\n'\n            '\\n'\n            '    // ── 🔴 相机 PTS 与 IMU 时间戳的**域差**(唯一没量过的量)────────────\\n'\n            '    // 上游把 `pts.seconds`(Core Media host clock)和 `record.timestamp`\\n'\n            '    // (CoreMotion,开机以来秒数)**原样透传、不做任何映射**。依据是苹果自己\\n'\n            '    // 的 `AVCaptureSession.h:630`:\\n'\n            '    //   \"Use synchronizationClock to synchronize AVCaptureOutput data with\\n'\n            '    //    external data sources (e.g motion samples). All capture output sample\\n'\n            '    //    buffer timestamps are on the synchronizationClock timebase.\"\\n'\n            '    // 纯视频会话的同步时钟就是 host clock,而 `CMLogItem.timestamp` 与\\n'\n            '    // `ProcessInfo.systemUptime` 同基 —— 两者本该同域。\\n'\n            '    //\\n'\n            '    // ⚠️ **但这只是文档论证,我没在机器上量过。** 传输层的单调闸只检查\\n'\n            '    //    **每条流自己**递增,**捕不到两条流之间的常值偏移**。而视觉-惯性\\n'\n            '    //    关联对这个偏移极其敏感:偏一点点,预积分就把错的那段惯性配给了\\n'\n            '    //    错的那两帧图像 —— 症状恰恰是平滑的无界漂移。\\