diff --git a/xrslam/src/xrslam/estimation/solver.cpp b/xrslam/src/xrslam/estimation/solver.cpp
index fe93a46..2a6d8ff 100644
--- a/xrslam/src/xrslam/estimation/solver.cpp
+++ b/xrslam/src/xrslam/estimation/solver.cpp
@@ -1,5 +1,8 @@
+#include <atomic>
 #include <ceres/ceres.h>
+#include <chrono>
 #include <xrslam/estimation/ceres/marginalization_factor.h>
+#include <xrslam/estimation/ceres/okvis_iteration_callback.h>
 #include <xrslam/estimation/ceres/preintegration_factor.h>
 #include <xrslam/estimation/ceres/quaternion_parameterization.h>
