+// [DEVICE-POSE-TRUST-V1 / REG-EVIDENCE-V1 2026-09-24] Pair generation for
+// frames that are PENDING at finalize (untrusted device pose, or trusted but
+// failed the evidence gate). Every other pair source of this route is chosen
+// by device pose (spatial K / spatial revisit / enrichment hints), which an
+// untrusted frame cannot use, so without this pass such a frame only has its
+// capture-time temporal window and the upstream registration loop sees no
+// 2D-3D evidence for it.
+// Upstream: ExhaustivePairGenerator (colmap/controllers/pairing.h/.cc, the
+// default matcher for sets of this size) restricted to the pairs that involve a
+// pending frame — pairs already in the db are skipped exactly like
+// AddOfficialQuadraticPairs does. Same matcher chain, ratio, COLMAP-default
+// TwoViewGeometryOptions and mandatory-gravity TVG persist gate as every other
+// finalize pass. Deviation: nearest-index-first order and the shared
+// finalize enrichment time budget (EnrichBudgetExhausted), so a pathological
+// capture cannot stall finalize.
+void AddPendingFrameExhaustivePairsV1(aether_sfm_session* s,
+                                      const std::vector<int>& pending) {
+  if (!s || !s->db || pending.empty() || s->frames.size() < 2) return;
+  const bool gpu_avail =
+      s->options.use_gpu_match && (aether_gpu_match_gemm_pairs != nullptr);
+  if (s->options.use_gpu_match && !gpu_avail) return;
+  const double t0 = NowMs();
+  int64_t attempted = 0, written = 0, budget_stopped = 0;
+  size_t n_todo = 0;
+  try {
+    const int num_frames = static_cast<int>(s->frames.size());
+    std::vector<std::pair<int, int>> todo;
+    std::unordered_set<uint64_t> seen;
+    for (const int p : pending) {
+      if (p < 0 || p >= num_frames || s->frames[p].image_id == 0) continue;
+      std::vector<int> others;
+      for (int j = 0; j < num_frames; ++j) {
+        if (j == p || s->frames[j].image_id == 0) continue;
+        others.push_back(j);
+      }
+      std::stable_sort(others.begin(), others.end(), [p](int a, int b) {
+        return std::abs(a - p) < std::abs(b - p);
+      });
+      for (const int j : others) {
+        const int i0 = std::min(p, j), j0 = std::max(p, j);
+        const uint64_t key = (static_cast<uint64_t>(i0) << 32) |
+                             static_cast<uint32_t>(j0);
+        if (!seen.insert(key).second) continue;
+        const colmap::image_t img1 = s->frames[i0].image_id;
+        const colmap::image_t img2 = s->frames[j0].image_id;
+        if (s->db->ExistsMatches(img1, img2) ||
+            s->db->ExistsTwoViewGeometry(img1, img2)) {
+          continue;
+        }
+        todo.emplace_back(i0, j0);
+      }
+    }
+    n_todo = todo.size();
+    const double ratio =
+        s->options.match_max_ratio > 0 ? s->options.match_max_ratio : 0.8;
+    const colmap::TwoViewGeometryOptions tvg_options;  // colmap defaults
+    std::vector<uint32_t> pair_buf;
+    // Feature access: in-memory FrameRecord, else a one-frame db load.
+    struct Feat {
+      std::vector<uint8_t> desc;
+      std::vector<Eigen::Vector2d> pts;
+    };
+    const auto load = [&](int i, Feat* store, const uint8_t** desc,
+                          const std::vector<Eigen::Vector2d>** pts,
+                          int* n) -> bool {
+      const FrameRecord& fr = s->frames[i];
+      if (!fr.descriptors.empty() && !fr.points.empty()) {
+        *desc = fr.descriptors.data();
+        *pts = &fr.points;
+        *n = fr.n_keypoints;
+        return *n > 0;
+      }
+      const colmap::FeatureKeypoints kps = s->db->ReadKeypoints(fr.image_id);
+      const colmap::FeatureDescriptors d = s->db->ReadDescriptors(fr.image_id);
+      const int nn = static_cast<int>(kps.size());
+      if (nn <= 0 || d.data.rows() != nn || d.data.cols() != 128) return false;
+      store->desc.assign(d.data.data(),
+                         d.data.data() + static_cast<size_t>(nn) * 128);
+      store->pts = colmap::FeatureKeypointsToPointsVector(kps);
+      *desc = store->desc.data();
+      *pts = &store->pts;
+      *n = nn;
+      return true;
+    };
+    size_t done = 0;
+    for (const auto& [i, j] : todo) {
+      if (EnrichBudgetExhausted(s)) {
+        budget_stopped = static_cast<int64_t>(todo.size() - done);
+        break;
+      }
+      ++done;
+      Feat sa, sb;
+      const uint8_t* da = nullptr;
+      const uint8_t* db = nullptr;
+      const std::vector<Eigen::Vector2d>* pa = nullptr;
+      const std::vector<Eigen::Vector2d>* pb = nullptr;
+      int na = 0, nb = 0;
+      if (!load(i, &sa, &da, &pa, &na) || !load(j, &sb, &db, &pb, &nb)) {
+        continue;
+      }
+      const int cap = na < nb ? na : nb;
+      if (cap <= 0) continue;
+      pair_buf.resize(static_cast<size_t>(cap) * 2);
+      int num_matches = 0;
+      ++attempted;
+      const int mrc =
+          gpu_avail ? GpuMatchGemmPairsRetry(s, s->frames[i].frame_id, da, na,
+                                             s->frames[j].frame_id, db, nb,
+                                             ratio, pair_buf.data(), cap,
+                                             &num_matches)
+                    : aether_sift_match_pairs(da, na, db, nb, ratio,
+                                              pair_buf.data(), cap,
+                                              &num_matches);
+      if (mrc != 0 || num_matches <= 0) continue;
+      colmap::FeatureMatches matches(num_matches);
+      for (int m = 0; m < num_matches; ++m) {
+        matches[m].point2D_idx1 = pair_buf[2 * m];
+        matches[m].point2D_idx2 = pair_buf[2 * m + 1];
+      }
+      const auto tvg = EstimateMandatoryFrameTwoViewGeometry(
+          s->frames[i], *pa, s->frames[j], *pb, matches, tvg_options);
+      if (!MandatoryGravityTvgPersistable(tvg)) continue;
+      s->db->WriteMatches(s->frames[i].image_id, s->frames[j].image_id,
+                          matches);
+      s->db->WriteTwoViewGeometry(s->frames[i].image_id,
+                                  s->frames[j].image_id, tvg.geometry);
+      ++written;
+    }
+  } catch (const std::exception& e) {
+    LOG(WARNING) << "[aether_sfm] pending-frame exhaustive pairs aborted: "
+                 << e.what();
+  } catch (...) {
+    LOG(WARNING) << "[aether_sfm] pending-frame exhaustive pairs aborted";
+  }
+  char line[256];
+  std::snprintf(line, sizeof(line),
+                "{\"t\":%lld,\"type\":\"pending_exhaustive_pairs_v1\","
+                "\"pending\":%zu,\"candidates\":%zu,\"attempted\":%lld,"
+                "\"written\":%lld,\"budget_stopped\":%lld,\"ms\":%.0f}",
+                static_cast<long long>(EpochMs()), pending.size(), n_todo,
+                (long long)attempted, (long long)written,
+                (long long)budget_stopped, NowMs() - t0);
+  AppendMatchFailJsonl(s, line);
+}
