+// [R3] during capture, over live_recon, session trial counter.
+static void RunLivePendingPassV1(aether_sfm_session* s) {
+  try {
+    LiveMapperCacheV1 c;
+    AcquireLiveMapperCacheV1(s, &c);
+    const colmap::IncrementalPipelineOptions opts = LiveOfficialOptionsV1(s);
+    const PendingPassResultV1 pr = RunPendingRegistrationSessionV1(
+        s, s->live_recon, c.cache, opts, "live", &s->reg_trials_v1);
+    for (const colmap::image_t id : pr.registered_ids) {
+      s->reg_order.push_back(id);
+    }
+  } catch (const std::exception& e) {
+    LOG(WARNING) << "[aether_sfm] live pending registration pass failed: "
+                 << e.what();
+  }
