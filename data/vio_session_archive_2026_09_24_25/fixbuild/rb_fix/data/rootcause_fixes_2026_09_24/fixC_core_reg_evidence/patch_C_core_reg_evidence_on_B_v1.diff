+
+bool FinalizeViaResumeEnabled() {
+  static const bool cached = [] {
+    const char* e = std::getenv("OFFICIAL_AETHER_FINALIZE_VIA_RESUME");
+    return e && e[0] == '1' && e[1] == '\0';
+  }();
