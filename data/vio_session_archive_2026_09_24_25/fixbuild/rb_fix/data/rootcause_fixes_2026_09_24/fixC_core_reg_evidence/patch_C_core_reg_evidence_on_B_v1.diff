+// [R1] at ingest: the frame is already placed at its device pose but has no
+// observation yet, so its own evidence (visible points / 2D-3D matches to the
+// OTHER registered images' points) is exactly what RegisterNextImage would see
+// for it as an unregistered image.
+static RegEvidenceV1 IngestEvidenceCheckV1(aether_sfm_session* s,
+                                           colmap::image_t image_id) {
+  RegEvidenceV1 ev;
+  LiveMapperCacheV1 c;
+  AcquireLiveMapperCacheV1(s, &c);
+  const colmap::IncrementalPipelineOptions opts = LiveOfficialOptionsV1(s);
+  colmap::IncrementalMapper mapper(c.cache);
+  mapper.BeginReconstruction(s->live_recon);
+  try {
+    ev = EvaluateRegistrationEvidenceV1(mapper, *c.cache, opts.Mapper(),
+                                        image_id);
+  } catch (const std::exception&) {
+    ev = RegEvidenceV1();
+    ev.reason = "exception";
+  }
+  mapper.EndReconstruction(/*discard=*/false);
+  return ev;
+}
