+          {for (final n in kCap0005Dead1) photo(n)},
+          {for (final n in kCap0005Dead2) photo(n)},
+        ],
+        legacyMultiSessionTrace: true,
+      );
+      for (final (n, _) in kCap0005Shots.take(7)) {
+        expect(plan.isTrusted(photo(n)), isFalse, reason: 'tap-$n 是旧世界');
