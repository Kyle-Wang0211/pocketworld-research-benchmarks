+                static_cast<CeresReprojectionErrorFactor *>(
+                    frame->reprojection_error_factors[jj].get())
+                    ->Evaluate(params, r.data(), nullptr);
+                Cr[k] += std::log1p(r.squaredNorm());
+                if (k == 0)
