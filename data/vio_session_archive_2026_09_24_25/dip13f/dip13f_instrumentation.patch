+            for (size_t jj = 0; jj < frame->keypoint_num(); ++jj) {
+                Track *track = frame->get_track(jj);
+                if (!track)
+                    continue;
+                if (!track->all_tagged(TT_VALID, TT_TRIANGULATED, TT_STATIC))
+                    continue;
+                if (!track->first_frame()->tag(FT_KEYFRAME))
+                    continue;
+                if (frame == track->first_frame())
+                    continue;
+                auto itr = idx.find(track->first_frame());
+                if (itr == idx.end())
