+    // prefer, and how well does it determine it (sd). Gauge-free: IMU is invariant to translation
+    // and to yaw about gravity.
+    double gn_ds = NAN, gn_sd = NAN, gn_ds_v = NAN, gn_sd_v = NAN, gn_tilt[2] = {NAN, NAN};
