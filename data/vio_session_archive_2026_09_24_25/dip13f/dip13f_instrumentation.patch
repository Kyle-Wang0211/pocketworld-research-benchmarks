+        const vector<3> axes[2] = {vector<3>(1, 0, 0), vector<3>(0, 1, 0)};
+        for (size_t j = 1; j < n; ++j) {
+            Frame *fi = map->get_frame(j - 1);
+            Frame *fj = map->get_frame(j);
+            if (fj->keyframe_preintegration.data.empty())
+                continue;
+            CeresPreIntegrationErrorFactor fac(fi, fj, fj->keyframe_preintegration);
+            const double *params[10] = {fi->pose.q.coeffs().data(), fi->pose.p.data(),
+                                        fi->motion.v.data(),        fi->motion.bg.data(),
+                                        fi->motion.ba.data(),       fj->pose.q.coeffs().data(),
+                                        fj->pose.p.data(),          fj->motion.v.data(),
+                                        fj->motion.bg.data(),       fj->motion.ba.data()};
+            vector<15> r;
+            matrix<15, 4, true> Jqi, Jqj;
+            matrix<15, 3, true> Jpi, Jvi, Jbgi, Jbai, Jpj, Jvj, Jbgj, Jbaj;
+            double *jac[10] = {Jqi.data(), Jpi.data(), Jvi.data(), Jbgi.data(), Jbai.data(),
+                               Jqj.data(), Jpj.data(), Jvj.data(), Jbgj.data(), Jbaj.data()};
+            fac.Evaluate(params, r.data(), jac);
+            matrix<> J = matrix<>::Zero(15, ncol);
+            J.col(0) = Jpi * (fi->pose.p - c) + Jpj * (fj->pose.p - c);
+            for (int a = 0; a < 2; ++a) {
+                J.col(1 + a) = Jqi.leftCols<3>() * (fi->pose.q.conjugate() * axes[a]) +
+                               Jpi * axes[a].cross(fi->pose.p - c) +
+                               Jqj.leftCols<3>() * (fj->pose.q.conjugate() * axes[a]) +
+                               Jpj * axes[a].cross(fj->pose.p - c);
+            }
+            J.middleCols<3>(3) = Jbai + Jbaj;
+            J.middleCols<3>(6 + 3 * (j - 1)) += Jvi;
+            J.middleCols<3>(6 + 3 * j) += Jvj;
+            H += J.transpose() * J;
+            gv += J.transpose() * r;
+        }
+        Eigen::FullPivLU<matrix<>> lu(H);
+        if (lu.rank() == ncol) {
+            matrix<> Hi = lu.inverse();
+            vector<> dz = -Hi * gv;
+            gn_ds = dz[0];
+            gn_sd = std::sqrt(std::max(0.0, Hi(0, 0)));
+            gn_tilt[0] = dz[1];
+            gn_tilt[1] = dz[2];
+            gn_dba = dz.segment<3>(3);
+        }
+        // v-only nuisance (drop tilt+ba columns)
+        std::vector<int> keep;
+        keep.push_back(0);
+        for (int k = 6; k < ncol; ++k)
+            keep.push_back(k);
+        matrix<> H2(keep.size(), keep.size());
+        vector<> g2(keep.size());
+        for (size_t a = 0; a < keep.size(); ++a) {
+            g2[a] = gv[keep[a]];
+            for (size_t b = 0; b < keep.size(); ++b)
+                H2(a, b) = H(keep[a], keep[b]);
+        }
+        Eigen::FullPivLU<matrix<>> lu2(H2);
+        if (lu2.rank() == (int)keep.size()) {
+            matrix<> H2i = lu2.inverse();
+            gn_ds_v = -(H2i * g2)[0];
+            gn_sd_v = std::sqrt(std::max(0.0, H2i(0, 0)));
+        }
+    }
+    fprintf(f,
+            "{\"ev\":\"imu_gn\",\"t\":%.9f,\"ds\":%.6g,\"sd\":%.6g,\"ds_v\":%.6g,\"sd_v\":%.6g,"
+            "\"tilt\":[%.6g,%.6g],\"dba\":[%.6g,%.6g,%.6g],\"ba\":[%.6g,%.6g,%.6g]}\n",
+            map->get_frame(n - 1)->image->t, gn_ds, gn_sd, gn_ds_v, gn_sd_v, gn_tilt[0], gn_tilt[1],
+            gn_dba.x(), gn_dba.y(), gn_dba.z(), map->get_frame(n - 1)->motion.ba.x(),
+            map->get_frame(n - 1)->motion.ba.y(), map->get_frame(n - 1)->motion.ba.z());
+
+    auto g = [&](const double *C) { return (C[2] - C[0]) / (2 * eps); };
+    auto I = [&](const double *C) { return (C[2] - 2 * C[1] + C[0]) / (eps * eps); };
+    Frame *last = map->get_frame(n - 1);
+    fprintf(f,
+            "{\"ev\":\"tension\",\"t\":%.9f,\"t0\":%.9f,\"n\":%zu,\"rms\":%.6g,\"n_imu\":%zu,"
+            "\"n_rep\":%zu,\"C_imu\":%.9g,\"g_imu\":%.9g,\"I_imu\":%.9g,\"C_pri\":%.9g,"
+            "\"g_pri\":%.9g,\"I_pri\":%.9g,\"C_rep\":%.9g,\"g_rep\":%.9g,\"I_rep\":%.9g,"
+            "\"has_prior\":%d}\n",
+            last->image->t, map->get_frame(0)->image->t, n, rms, n_imu, n_rep, Ci[1], g(Ci),
+            I(Ci), Cp[1], g(Cp), I(Cp), Cr[1], g(Cr), I(Cr), mf ? 1 : 0);
+}
+
+// Called from CeresMarginalizationFactor::marginalize() (header) after the new prior is built.
+void pw_s3_log_marg(double incoming_max_sqrt, double pre_schur_max_diag, const matrix<> &H,
+                    const vector<> &evals, const matrix<> &evecs, const matrix<> &sqrt_inv_cov,
+                    const std::vector<Frame *> &frames) {
+    FILE *f = pw_s3_log();
+    if (!f)
+        return;
+    const int N = (int)H.rows();
+    double hmax = 0, hnorm = H.norm();
+    for (int i = 0; i < N; ++i)
+        hmax = std::max(hmax, std::abs(H(i, i)));
+    int n_trunc = 0, n_neg = 0;
+    double lmin_pos = INFINITY, lmax = -INFINITY, lmin = INFINITY;
+    for (int i = 0; i < N; ++i) {
+        double l = evals[i];
+        lmax = std::max(lmax, l);
+        lmin = std::min(lmin, l);
+        if (l <= 1.0e-8)
+            ++n_trunc;
+        else
+            lmin_pos = std::min(lmin_pos, l);
+        if (l < 0)
+            ++n_neg;
+    }
+    double recon = (H - evecs * evals.asDiagonal() * evecs.transpose()).norm() / hnorm;
+    // Jacobi-scaled spectrum: precision-independent count of genuine near-null directions
+    vector<> dsc(N);
+    for (int i = 0; i < N; ++i)
+        dsc[i] = H(i, i) > 0 ? 1.0 / std::sqrt(H(i, i)) : 1.0;
+    matrix<> Hs = dsc.asDiagonal() * H * dsc.asDiagonal();
+    Eigen::SelfAdjointEigenSolver<matrix<>> es2(Hs, Eigen::EigenvaluesOnly);
+    int n_null_s = 0;
+    for (int i = 0; i < N; ++i)
+        if (es2.eigenvalues()[i] < 1.0e-12 * es2.eigenvalues().maxCoeff())
+            ++n_null_s;
+    // directions over the prior's frames (ordered as `frames`)
+    const size_t nf = frames.size();
+    vector<3> c = vector<3>::Zero();
+    for (auto *fr : frames)
+        c += fr->pose.p;
+    c /= double(nf);
+    auto quad = [&](const vector<> &d, double &raw, double &tr) {
+        raw = d.dot(H * d);
+        tr = (sqrt_inv_cov * d).squaredNorm();
+    };
+    vector<> ds = vector<>::Zero(N), dtx = vector<>::Zero(N), dtz = vector<>::Zero(N),
+             dyaw = vector<>::Zero(N), droll = vector<>::Zero(N);
+    const vector<3> ez(0, 0, 1), ex(1, 0, 0);
+    for (size_t i = 0; i < nf && (int)(ES_SIZE * i + ES_SIZE) <= N; ++i) {
+        const Frame *fr = frames[i];
+        ds.segment<3>(ES_SIZE * i + ES_P) = fr->pose.p - c;
+        ds.segment<3>(ES_SIZE * i + ES_V) = fr->motion.v;
+        dtx.segment<3>(ES_SIZE * i + ES_P) = ex;
+        dtz.segment<3>(ES_SIZE * i + ES_P) = ez;
+        // world-axis rotation about c: q' = R(a) q  => body-frame tangent = q^-1 a
+        dyaw.segment<3>(ES_SIZE * i + ES_Q) = fr->pose.q.conjugate() * ez;
+        dyaw.segment<3>(ES_SIZE * i + ES_P) = ez.cross(fr->pose.p - c);
+        dyaw.segment<3>(ES_SIZE * i + ES_V) = ez.cross(fr->motion.v);
+        droll.segment<3>(ES_SIZE * i + ES_Q) = fr->pose.q.conjugate() * ex;
+        droll.segment<3>(ES_SIZE * i + ES_P) = ex.cross(fr->pose.p - c);
+        droll.segment<3>(ES_SIZE * i + ES_V) = ex.cross(fr->motion.v);
+    }
+    // conditional (gauge-free) scale information: Schur-complement translation(3)+yaw(1) out of
+    // the 5x5 directional information block, for the raw H and for the truncated prior.
+    vector<> dty = vector<>::Zero(N);
+    for (size_t i = 0; i < nf && (int)(ES_SIZE * i + ES_SIZE) <= N; ++i)
+        dty.segment<3>(ES_SIZE * i + ES_P) = vector<3>(0, 1, 0);
+    matrix<> D(N, 5);
+    D.col(0) = ds;
+    D.col(1) = dtx;
+    D.col(2) = dty;
+    D.col(3) = dtz;
+    D.col(4) = dyaw;
+    matrix<> M_raw = D.transpose() * H * D;
+    matrix<> SD = sqrt_inv_cov * D;
+    matrix<> M_tr = SD.transpose() * SD;
+    auto cond_info = [](const matrix<> &M) {
+        matrix<> Mgg = M.bottomRightCorner(4, 4);
+        Eigen::FullPivLU<matrix<>> lu(Mgg);
+        if (lu.rank() < 4)
+            return (double)NAN;
+        return M(0, 0) - (M.block(0, 1, 1, 4) * lu.solve(M.block(1, 0, 4, 1)))(0, 0);
+    };
+    const double Isc_raw = cond_info(M_raw), Isc_tr = cond_info(M_tr);
+    double s_raw, s_tr, tx_raw, tx_tr, tz_raw, tz_tr, y_raw, y_tr, r_raw, r_tr;
+    quad(ds, s_raw, s_tr);
+    quad(dtx, tx_raw, tx_tr);
+    quad(dtz, tz_raw, tz_tr);
+    quad(dyaw, y_raw, y_tr);
+    quad(droll, r_raw, r_tr);
+    fprintf(f,
+            "{\"ev\":\"marg\",\"t0\":%.9f,\"N\":%d,\"in_max_sqrt\":%.6g,\"pre_max_diag\":%.6g,"
+            "\"hmax_diag\":%.6g,\"lmax\":%.6g,\"lmin\":%.6g,\"lmin_pos\":%.6g,\"n_trunc\":%d,"
+            "\"n_neg\":%d,\"recon\":%.3g,\"n_null_scaled\":%d,\"lmin_scaled\":%.6g,"
+            "\"I_scale\":[%.6g,%.6g],\"I_tx\":[%.6g,%.6g],\"I_tz\":[%.6g,%.6g],"
+            "\"I_yaw\":[%.6g,%.6g],\"I_roll\":[%.6g,%.6g],\"I_scale_cond\":[%.6g,%.6g]}\n",
+            frames.empty() ? 0.0 : frames[0]->image->t, N, incoming_max_sqrt, pre_schur_max_diag,
+            hmax, lmax, lmin, lmin_pos, n_trunc, n_neg, recon, n_null_s, es2.eigenvalues().minCoeff(),
+            s_raw, s_tr, tx_raw, tx_tr, tz_raw, tz_tr, y_raw, y_tr, r_raw, r_tr, Isc_raw, Isc_tr);
+}
+
+} // namespace xrslam
