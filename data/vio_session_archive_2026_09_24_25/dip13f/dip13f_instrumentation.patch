+#ifndef XRSLAM_PW_S3_LOG_H
+#define XRSLAM_PW_S3_LOG_H
+// [S3 scale-root-cause, scratch only, never committed] Logging-only instrumentation.
+// Everything is gated on PW_S3_LOG=<path>; with it unset no extra code runs at all.
+// With it set, the hooks only READ engine state (copies, const Evaluate, eigen solves on copies);
+// bit-identical trajectories with the log on/off are the acceptance test.
+#include <cstdio>
+#include <vector>
+#include <xrslam/common.h>
+
+namespace xrslam {
+class Map;
+class Frame;
+FILE *pw_s3_log();
+// refine_window(): directional (global-scale) cost terms of IMU factors vs marginalization prior
+void pw_s3_scale_tension(Map *map);
+// slide_window(): final (smoothed) state of the frame about to be marginalized
+void pw_s3_log_frame(const char *tag, const Frame *frame);
+// marginalize(): spectrum + directional information of the new prior
+void pw_s3_log_marg(double incoming_max_sqrt, double pre_schur_max_diag, const matrix<> &H,
+                    const vector<> &evals, const matrix<> &evecs, const matrix<> &sqrt_inv_cov,
+                    const std::vector<Frame *> &frames);
+// [dip13f, scratch only] per-thread scratch filled by Frame::track_keypoints (FT thread) and a
+// context label consumed by Solver::solve(). Written only when pw_s3_log() is non-null.
+struct PwDipFt {
+    int n_curr = 0, n_lk = 0, n_ess = 0, n_rot = 0, n_out = 0;
+    double misalign = 0;
+    double med_flow = 0; // median |next - curr| px of LK-tracked points (motion/blur proxy)
+};
+extern thread_local PwDipFt pw_dip_ft;
+extern thread_local const char *pw_dip_solve_ctx;
+extern thread_local double pw_dip_solve_t;
+} // namespace xrslam
+
+#endif
