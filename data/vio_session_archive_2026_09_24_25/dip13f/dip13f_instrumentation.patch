+// statistics of a linear LS solve A x = b: singular values, residual rms, std error of x(k)
+std::string pw_s3_lsq(const xrslam::matrix<> &A, const xrslam::vector<> &b, const xrslam::vector<> &x,
+                      int k) {
+    using namespace xrslam;
+    Eigen::JacobiSVD<matrix<>> svd(A);
+    const vector<> &sv = svd.singularValues();
+    vector<> r = A * x - b;
+    const int m = (int)A.rows(), n = (int)A.cols();
+    double sig2 = r.squaredNorm() / std::max(1, m - n);
+    matrix<> AtA = A.transpose() * A;
+    double var_k = sig2 * AtA.inverse()(k, k);
+    // column-normalized conditioning (unit-free)
+    matrix<> An = A;
+    for (int j = 0; j < n; ++j) {
+        double cn = A.col(j).norm();
+        if (cn > 0)
+            An.col(j) /= cn;
+    }
+    Eigen::JacobiSVD<matrix<>> svdn(An);
+    const vector<> &svn = svdn.singularValues();
+    // how strongly is x(k) tied to the smallest right-singular direction
+    Eigen::JacobiSVD<matrix<>> svdv(A, Eigen::ComputeThinV);
+    double vk = std::abs(svdv.matrixV()(k, n - 1));
+    char buf[512];
+    snprintf(buf, sizeof buf,
+             "\"sv_max\":%.6g,\"sv_min\":%.6g,\"cond\":%.6g,\"condn\":%.6g,\"rms\":%.6g,"
+             "\"x_k\":%.9g,\"std_k\":%.6g,\"rel_std_k\":%.6g,\"vmin_k\":%.4g",
+             sv[0], sv[n - 1], sv[0] / sv[n - 1], svn[0] / svn[n - 1], std::sqrt(r.squaredNorm() / m),
+             x[k], std::sqrt(std::max(0.0, var_k)), std::sqrt(std::max(0.0, var_k)) / std::abs(x[k]),
+             vk);
+    return buf;
+}
