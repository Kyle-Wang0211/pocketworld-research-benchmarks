+// Directional analysis of the window cost along a global similarity "scale" direction:
+//   body p_i -> c + s (p_i - c), v_i -> s v_i, landmark inv_depth -> inv_depth / s, q/bg/ba fixed.
+// Returns (per term) C(s) = sum of squared whitened residuals (reprojection: sum rho(|r|^2),
+// Cauchy(1) as in the solver). g = dC/dlog s, I = d2C/dlog s^2 by central differences, eps=1e-2.
+// Self-check: at the solver optimum g_imu + g_prior + g_rep ~ 0 (can fail if not converged).
+void pw_s3_scale_tension(Map *map) {
+    FILE *f = pw_s3_log();
+    if (!f)
+        return;
+    const size_t n = map->frame_num();
+    if (n < 2)
+        return;
+    std::unordered_map<const Frame *, size_t> idx;
+    vector<3> c = vector<3>::Zero();
+    for (size_t i = 0; i < n; ++i) {
+        idx[map->get_frame(i)] = i;
+        c += map->get_frame(i)->pose.p;
+    }
+    c /= double(n);
+    double rms = 0;
+    for (size_t i = 0; i < n; ++i)
+        rms += (map->get_frame(i)->pose.p - c).squaredNorm();
+    rms = std::sqrt(rms / n);
+
+    const double eps = 1.0e-2;
+    const double svals[3] = {std::exp(-eps), 1.0, std::exp(eps)};
+    double Ci[3] = {0, 0, 0}, Cp[3] = {0, 0, 0}, Cr[3] = {0, 0, 0};
+    size_t n_imu = 0, n_rep = 0;
+    CeresMarginalizationFactor *mf =
+        static_cast<CeresMarginalizationFactor *>(map->marginalization_factor.get());
+    for (int k = 0; k < 3; ++k) {
+        const double s = svals[k];
+        std::vector<quaternion> q(n);
+        std::vector<vector<3>> p(n), v(n), bg(n), ba(n);
+        for (size_t i = 0; i < n; ++i) {
+            const Frame *fr = map->get_frame(i);
+            q[i] = fr->pose.q;
+            p[i] = c + s * (fr->pose.p - c);
+            v[i] = s * fr->motion.v;
+            bg[i] = fr->motion.bg;
+            ba[i] = fr->motion.ba;
+        }
+        // IMU factors (same pairs refine_window() put into the solver)
+        for (size_t j = 1; j < n; ++j) {
+            Frame *fi = map->get_frame(j - 1);
+            Frame *fj = map->get_frame(j);
+            if (fj->keyframe_preintegration.data.empty())
+                continue;
+            CeresPreIntegrationErrorFactor fac(fi, fj, fj->keyframe_preintegration);
+            const double *params[10] = {q[j - 1].coeffs().data(), p[j - 1].data(),
+                                        v[j - 1].data(),          bg[j - 1].data(),
+                                        ba[j - 1].data(),         q[j].coeffs().data(),
+                                        p[j].data(),              v[j].data(),
+                                        bg[j].data(),             ba[j].data()};
