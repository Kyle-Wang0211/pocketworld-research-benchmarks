+            std::vector<const double *> params;
+            bool ok = true;
+            for (Frame *fr : lf) {
+                auto it = idx.find(fr);
+                if (it == idx.end()) {
+                    ok = false;
+                    break;
+                }
+                size_t i = it->second;
+                params.push_back(q[i].coeffs().data());
+                params.push_back(p[i].data());
+                params.push_back(v[i].data());
+                params.push_back(bg[i].data());
+                params.push_back(ba[i].data());
+            }
+            if (ok) {
+                vector<> r(lf.size() * ES_SIZE);
+                mf->Evaluate(params.data(), r.data(), nullptr);
+                Cp[k] = r.squaredNorm();
+            } else {
+                Cp[k] = NAN;
+            }
